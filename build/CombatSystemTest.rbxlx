	<Item class="SoundService" referent="RBXBASE000009"><Properties><string name="Name">SoundService</string></Properties></Item>
	<Item class="StarterPlayer" referent="RBXBASE000100"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBXBASE000101"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBXCS000018"><Properties><string name="Name">CombatClient</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local remotes = ReplicatedStorage:WaitForChild("CombatRemotes", 30)
local actionRemote = remotes and remotes:WaitForChild("CombatAction", 10)
local stateRemote = remotes and remotes:WaitForChild("CombatState", 10)
if not actionRemote or not stateRemote then
	warn("[CombatSystem] CombatRemotes not found in ReplicatedStorage; combat input is disabled.")
	return
end

local config = require(ReplicatedStorage:WaitForChild("CombatConfig"))
local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))
local ProceduralAnimator = require(script.ProceduralAnimator)
local MovementController = require(script.MovementController)
local CombatInput = require(script.CombatInput)
local ShieldIndicator = require(script.ShieldIndicator)
local HudController = require(script.HudController)
local Effects = require(script.Effects)
local DebugPanel = require(script.DebugPanel)

local context = {
	player = player,
	config = config,
	cooldowns = {},
	cooldownDurations = {},
	animator = ProceduralAnimator,
	effects = Effects,
}

function context.send(...)
	actionRemote:FireServer(...)
end

function context.now(): number
	return Workspace:GetServerTimeNow()
end

function context.stats()
	local s = {}
	for key, default in pairs(config.stats.defaults) do
		local v = player:GetAttribute("Stat_" .. key)
		s[key] = if type(v) == "number" then v else default
	end
	return s
end

function context.resolve(value)
	return CombatShared.resolve(value, context.stats())
end

function context.hasUnlock(key: string): boolean
	return player:GetAttribute("Unlock_" .. key) == true
end

function context.setCooldown(id: string, untilTime: number, duration: number)
	context.cooldowns[id] = untilTime
	context.cooldownDurations[id] = duration
end

function context.cooldownRemaining(id: string): number
	local untilTime = context.cooldowns[id]
	if not untilTime then
		return 0
	end
	return math.max(0, untilTime - context.now())
end

function context.combatState(): string
	local character = player.Character
	local state = character and character:GetAttribute("CombatState")
	return if type(state) == "string" then state else "Idle"
end

function context.currentWeapon()
	local character = player.Character
	local name = character and character:GetAttribute("Weapon")
	if type(name) ~= "string" then
		name = config.defaultWeapon
	end
	return name, config.weapons[name]
end

local function animationFor(weaponName, kind, key)
	local weapon = config.weapons[weaponName]
	if not weapon then
		return nil
	end
	if kind == "m1" then
		local hit = type(key) == "number" and weapon.m1.hits[key]
		return hit and hit.animation
	elseif kind == "ability" then
		for _, ability in ipairs(weapon.abilities) do
			if ability.id == key then
				return ability.animation
			end
		end
	end
	return nil
end

local movement = MovementController.new(context)
context.movement = movement
CombatInput.new(context)
local shields = ShieldIndicator.new(config.hud.indicatorDistance, config.hud.shieldWidthStuds)
local debugPanel = DebugPanel.new(context)
task.spawn(HudController.new, context)

local LOCAL_FX = { doubleJump = true, skyJump = true }

stateRemote.OnClientEvent:Connect(function(kind, ...)
	if kind == "cooldown" then
		local id, untilTime, duration = ...
		if type(id) == "string" and type(untilTime) == "number" and type(duration) == "number" then
			context.setCooldown(id, untilTime, duration)
		end
	elseif kind == "fx" then
		local effect, model = ...
		if LOCAL_FX[effect] and model == player.Character then
			return
		end
		if (effect == "hitbox" or effect == "hitsphere") and not debugPanel:wantsHitboxes() then
			return
		end
		Effects.play(...)
		if effect == "guardBreak" then
			shields:shatter(model)
		end
	elseif kind == "anim" then
		local model, weaponName, animKind, key = ...
		if typeof(model) == "Instance" and model:IsA("Model") then
			local animation = animationFor(weaponName, animKind, key)
			if animation then
				ProceduralAnimator.play(model, animation)
			end
		end
	elseif kind == "projectile" then
		local id, origin, direction, speed, range, weaponName = ...
		Effects.projectile(id, origin, direction, speed, range, weaponName, config)
	elseif kind == "debug" then
		debugPanel:setEnabled((...) == true)
	elseif kind == "projectileEnd" then
		Effects.projectileEnd(...)
	else
		movement:onServer(kind, ...)
	end
end)

local function onCharacter(character: Model)
	movement:bind(character)
end

local function watchActor(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local function refresh()
		local state = model:GetAttribute("CombatState")
		local own = model == player.Character
		if state == "Blocking" then
			shields:set(model, own or config.block.showToOthers)
			ProceduralAnimator.startGuard(model)
		else
			shields:set(model, false)
			ProceduralAnimator.stopGuard(model)
		end
		if not own then
			if state == "Climbing" then
				ProceduralAnimator.startClimb(model)
			else
				ProceduralAnimator.stopClimb(model)
			end
		end
	end
	model:GetAttributeChangedSignal("CombatState"):Connect(refresh)
	refresh()
end

CollectionService:GetInstanceAddedSignal(CombatShared.ACTOR_TAG):Connect(watchActor)
for _, model in ipairs(CollectionService:GetTagged(CombatShared.ACTOR_TAG)) do
	task.spawn(watchActor, model)
end

player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

actionRemote:FireServer("Sync")
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBXCS000019"><Properties><string name="Name">ClimbIndicator</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FULL = Color3.fromRGB(120, 255, 140)
local MID = Color3.fromRGB(255, 220, 90)
local LOW = Color3.fromRGB(255, 80, 80)

local ClimbIndicator = {}
ClimbIndicator.__index = ClimbIndicator

function ClimbIndicator.new(distance: number)
	return setmetatable({ gui = nil, distance = distance, warned = false, lastFraction = -1 }, ClimbIndicator)
end

function ClimbIndicator:_ensure(): boolean
	if self.gui and self.gui.Parent then
		return true
	end
	local template = ReplicatedStorage:FindFirstChild("ClimbIndicator")
	if not template or not template:IsA("BillboardGui") then
		if not self.warned then
			self.warned = true
			warn("[CombatSystem] ClimbIndicator (BillboardGui) not found in ReplicatedStorage; the climb stamina ring is disabled.")
		end
		return false
	end
	local gui = template:Clone()
	gui.Enabled = false
	gui.ResetOnSpawn = false
	gui.MaxDistance = self.distance
	local ring = gui:FindFirstChild("Ring")
	local left = ring and ring:FindFirstChild("LeftHalf")
	local right = ring and ring:FindFirstChild("RightHalf")
	local leftStroke = left and left:FindFirstChild("Circle") and left.Circle:FindFirstChild("Stroke")
	local rightStroke = right and right:FindFirstChild("Circle") and right.Circle:FindFirstChild("Stroke")
	local leftGradient = leftStroke and leftStroke:FindFirstChild("Gradient")
	local rightGradient = rightStroke and rightStroke:FindFirstChild("Gradient")
	if not (leftStroke and rightStroke and leftGradient and rightGradient) then
		if not self.warned then
			self.warned = true
			warn("[CombatSystem] ClimbIndicator is missing Ring/LeftHalf/RightHalf/Circle/Stroke/Gradient; the climb stamina ring is disabled.")
		end
		gui:Destroy()
		return false
	end
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	self.gui = gui
	self.strokes = { leftStroke, rightStroke }
	self.leftGradient = leftGradient
	self.rightGradient = rightGradient
	return true
end

function ClimbIndicator:show(root: BasePart)
	if not self:_ensure() then
		return
	end
	self.gui.Adornee = root
	self.gui.Enabled = true
	self.lastFraction = -1
	self:update(1)
end

function ClimbIndicator:update(fraction: number)
	if not self.gui or not self.gui.Enabled then
		return
	end
	fraction = math.clamp(fraction, 0, 1)
	if math.abs(fraction - self.lastFraction) < 0.002 then
		return
	end
	self.lastFraction = fraction
	local angle = fraction * 360
	self.rightGradient.Rotation = math.clamp(angle, 0, 180)
	self.leftGradient.Rotation = math.clamp(angle, 180, 360)
	local color = if fraction > 0.5 then FULL elseif fraction > 0.25 then MID else LOW
	for _, stroke in ipairs(self.strokes) do
		stroke.Color = color
	end
end

function ClimbIndicator:hide()
	if self.gui then
		self.gui.Enabled = false
		self.gui.Adornee = nil
	end
end

return ClimbIndicator
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000020"><Properties><string name="Name">CombatInput</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))

local Workspace = game:GetService("Workspace")

local FACE_TIME = 0.45
local AIM_RANGE = 1000
local RESEND_INTERVAL = 0.12
local BLOCK_RETRY_INTERVAL = 0.25

local CombatInput = {}
CombatInput.__index = CombatInput

function CombatInput.new(ctx)
	local self = setmetatable({
		ctx = ctx,
		attackHeld = false,
		blockHeld = false,
		blockSent = false,
		lastM1Sent = -math.huge,
		lastBlockSent = -math.huge,
		blockKey = CombatShared.keyCode(ctx.config.keys.block),
		lastForwardTap = -math.huge,
		running = false,
		faceUntil = 0,
		faceYaw = 0,
		facing = false,
	}, CombatInput)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.attackHeld = true
			self:_tryM1()
		elseif input.KeyCode == self.blockKey then
			self.blockHeld = true
			self:_tryBlock()
		elseif input.KeyCode == Enum.KeyCode.W then
			local now = os.clock()
			if now - self.lastForwardTap <= ctx.config.run.doubleTapWindow and not self.running then
				self.running = true
				ctx.send("Run", true)
			end
			self.lastForwardTap = now
		elseif input.KeyCode ~= Enum.KeyCode.Unknown then
			self:_tryAbility(input.KeyCode)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.attackHeld = false
		elseif input.KeyCode == Enum.KeyCode.W then
			if self.running then
				self.running = false
				ctx.send("Run", false)
			end
		elseif input.KeyCode == self.blockKey then
			self.blockHeld = false
			if self.blockSent then
				self.blockSent = false
				ctx.send("Block", false)
			end
		end
	end)
	RunService.Heartbeat:Connect(function()
		self:_step()
	end)
	return self
end

function CombatInput:_aim(): (number, number)
	local ctx = self.ctx
	local character = ctx.player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = Workspace.CurrentCamera
	if not root or not camera then
		return 0, 0
	end
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local result = Workspace:Raycast(ray.Origin, ray.Direction * AIM_RANGE, params)
	local origin = root.Position
	local target = if result then result.Position else ray.Origin + ray.Direction * AIM_RANGE
	if result then
		local model = result.Instance:FindFirstAncestorOfClass("Model")
		local targetRoot = model and model:FindFirstChild("HumanoidRootPart")
		if targetRoot and model:FindFirstChildOfClass("Humanoid") then
			target = targetRoot.Position
		end
	end
	local direction = target - origin
	if direction.Magnitude < 2 then
		direction = ray.Direction
	end
	local yaw, pitch = CombatShared.aimAngles(direction)
	if CombatShared.flat(direction).Magnitude < 0.05 then
		yaw = CombatShared.aimAngles(CombatShared.flat(root.CFrame.LookVector))
	end
	return yaw, pitch
end

function CombatInput:_face(yaw: number)
	self.faceYaw = yaw
	self.faceUntil = os.clock() + FACE_TIME
end

function CombatInput:_applyFacing()
	local character = self.ctx.player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not hum or not root then
		return
	end
	local state = self.ctx.combatState()
	if os.clock() < self.faceUntil and (state == "Attacking" or state == "Idle") then
		if not self.facing then
			self.facing = true
			self.restoreAutoRotate = hum.AutoRotate
		end
		hum.AutoRotate = false
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, self.faceYaw, 0)
	elseif self.facing then
		self.facing = false
		hum.AutoRotate = self.restoreAutoRotate ~= false and self.ctx.combatState() ~= "Climbing"
	end
end

function CombatInput:_ready(): boolean
	local ctx = self.ctx
	local character = ctx.player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0 and ctx.combatState() == "Idle"
end

function CombatInput:_tryM1()
	local ctx = self.ctx
	if not self:_ready() or ctx.cooldownRemaining("M1") > 0 or os.clock() - self.lastM1Sent < RESEND_INTERVAL then
		return
	end
	self.lastM1Sent = os.clock()
	ctx.send("M1")
end

function CombatInput:_tryBlock()
	if not self:_ready() or os.clock() - self.lastBlockSent < BLOCK_RETRY_INTERVAL then
		return
	end
	self.lastBlockSent = os.clock()
	self.blockSent = true
	self.ctx.send("Block", true)
end

function CombatInput:_tryAbility(keyCode: Enum.KeyCode)
	local ctx = self.ctx
	local weaponName, weapon = ctx.currentWeapon()
	if not weapon then
		return
	end
	for _, ability in ipairs(weapon.abilities) do
		if CombatShared.keyCode(ability.key) == keyCode then
			if self:_ready() and ctx.cooldownRemaining(weaponName .. "." .. ability.id) <= 0 then
				if ability.kind == "projectile" then
					local yaw, pitch = self:_aim()
					self:_face(yaw)
					ctx.send("Ability", ability.id, yaw, pitch)
				else
					ctx.send("Ability", ability.id)
				end
			end
			return
		end
	end
end

function CombatInput:_step()
	self:_applyFacing()
	if self.attackHeld then
		self:_tryM1()
	end
	if self.blockHeld and self.ctx.combatState() == "Idle" then
		self:_tryBlock()
	end
end

return CombatInput
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000021"><Properties><string name="Name">DebugPanel</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local REFRESH_INTERVAL = 0.1
local SCAN_INTERVAL = 2
local MAX_NPC_ROWS = 6

local DebugPanel = {}
DebugPanel.__index = DebugPanel

function DebugPanel.new(ctx)
	local self = setmetatable({
		ctx = ctx,
		enabled = false,
		hitboxes = false,
		npcs = {},
		lastScan = -math.huge,
		fps = 60,
	}, DebugPanel)
	task.spawn(function()
		self:_bind()
	end)
	return self
end

function DebugPanel:_bind()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = playerGui:WaitForChild("CombatDebug", 15)
	if not gui then
		warn("[CombatSystem] still waiting for CombatDebug in PlayerGui; is it in StarterGui?")
		gui = playerGui:WaitForChild("CombatDebug")
	end
	local toggle = gui:WaitForChild("Toggle", 5)
	local panel = gui:WaitForChild("Panel", 5)
	local hitboxButton = panel and panel:WaitForChild("HitboxButton", 5)
	local skyButton = panel and panel:WaitForChild("SkyJumpButton", 5)
	local info = panel and panel:WaitForChild("Info", 5)
	if not (toggle and panel and hitboxButton and skyButton and info) then
		warn("[CombatSystem] CombatDebug is missing Toggle/Panel/HitboxButton/SkyJumpButton/Info; the debug panel is disabled.")
		return
	end
	self.gui, self.toggle, self.panel, self.hitboxButton, self.skyButton, self.info = gui, toggle, panel, hitboxButton, skyButton, info
	toggle.Activated:Connect(function()
		self.ctx.send("Debug", not self.enabled)
	end)
	hitboxButton.Activated:Connect(function()
		self.hitboxes = not self.hitboxes
		hitboxButton.Text = if self.hitboxes then "Hitboxes: ON" else "Hitboxes: OFF"
	end)
	skyButton.Activated:Connect(function()
		self.ctx.send("DebugUnlock", "skyJump", not self.ctx.hasUnlock("skyJump"))
	end)
	local elapsed = 0
	RunService.RenderStepped:Connect(function(dt)
		self.fps += (1 / math.max(dt, 1e-3) - self.fps) * 0.1
		elapsed += dt
		if self.enabled and elapsed >= REFRESH_INTERVAL then
			elapsed = 0
			self:_refresh()
		end
	end)
end

function DebugPanel:setEnabled(allowed: boolean)
	self.enabled = allowed
	if self.panel then
		self.panel.Visible = allowed
		self.toggle.Text = if allowed then "DEBUG ON" else "DEBUG"
	end
	if not allowed then
		self.hitboxes = false
		if self.hitboxButton then
			self.hitboxButton.Text = "Hitboxes: OFF"
		end
	end
end

function DebugPanel:wantsHitboxes(): boolean
	return self.hitboxes or self.ctx.config.debug.showHitboxes
end

function DebugPanel:_scan()
	local now = os.clock()
	if now - self.lastScan < SCAN_INTERVAL then
		return
	end
	self.lastScan = now
	table.clear(self.npcs)
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:IsA("Model") and type(inst:GetAttribute("CombatProfile")) == "string" then
			table.insert(self.npcs, inst)
		end
	end
end

function DebugPanel:_refresh()
	local ctx = self.ctx
	self.skyButton.Text = if ctx.hasUnlock("skyJump") then "Sky Jump: ON" else "Sky Jump: OFF"
	local character = ctx.player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local lines = {}
	table.insert(lines, ("FPS %d  ping %dms"):format(self.fps, ctx.player:GetNetworkPing() * 2000))
	if character and hum and root then
		local weapon = ctx.currentWeapon()
		table.insert(lines, ("state   %s"):format(ctx.combatState()))
		table.insert(lines, ("weapon  %s"):format(weapon))
		table.insert(lines, ("health  %d / %d"):format(hum.Health, hum.MaxHealth))
		table.insert(lines, ("shield  %d / %d"):format(character:GetAttribute("Shield") or 0, character:GetAttribute("ShieldMax") or 0))
		table.insert(lines, ("speed   %.1f (walk %.1f)"):format(root.AssemblyLinearVelocity.Magnitude, hum.WalkSpeed))
		table.insert(lines, ("airJumps %d  skyJump %s"):format(ctx.movement.airJumps or 0, tostring(ctx.hasUnlock("skyJump"))))
	end
	local stats = ctx.stats()
	local keys = {}
	for key in pairs(stats) do
		table.insert(keys, key)
	end
	table.sort(keys)
	local parts = {}
	for _, key in ipairs(keys) do
		table.insert(parts, ("%s=%g"):format(key, stats[key]))
	end
	table.insert(lines, "stats   " .. table.concat(parts, " "))
	table.insert(lines, "-- cooldowns")
	local ids = {}
	for id in pairs(ctx.cooldowns) do
		if ctx.cooldownRemaining(id) > 0 then
			table.insert(ids, id)
		end
	end
	table.sort(ids)
	if #ids == 0 then
		table.insert(lines, "none")
	end
	for _, id in ipairs(ids) do
		table.insert(lines, ("%s %.1fs"):format(id, ctx.cooldownRemaining(id)))
	end
	self:_scan()
	table.insert(lines, "-- npcs")
	local shown = 0
	for _, model in ipairs(self.npcs) do
		local npcRoot = model.Parent and model:FindFirstChild("HumanoidRootPart")
		local npcHum = model:FindFirstChildOfClass("Humanoid")
		if npcRoot and npcHum and root and shown < MAX_NPC_ROWS then
			shown += 1
			table.insert(lines, ("%s %s hp%d %dst %s"):format(
				model:GetAttribute("CombatProfile"),
				tostring(model:GetAttribute("CombatState") or "-"),
				npcHum.Health,
				(npcRoot.Position - root.Position).Magnitude,
				npcRoot.CFrame.UpVector.Y < 0.9 and "TILTED" or "ok"
			))
		end
	end
	self.info.Text = table.concat(lines, "\n")
end

return DebugPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000022"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))

local RINGS = {
	doubleJump = { size = 5, time = 0.25, color = Color3.fromRGB(230, 240, 255) },
	skyJump = { size = 9, time = 0.35, color = Color3.fromRGB(255, 255, 255) },
}

local FLASHES = {
	hit = { color = Color3.fromRGB(255, 60, 60), time = 0.15 },
	blocked = { color = Color3.fromRGB(200, 230, 255), time = 0.12 },
	guardBreak = { color = Color3.fromRGB(255, 210, 70), time = 0.35 },
	dodge = { color = Color3.fromRGB(150, 255, 200), time = 0.15 },
}

local ELEMENT_COLORS = {
	fire = Color3.fromRGB(255, 120, 30),
}

local Effects = {}

local projectiles = {}
local projectileConnection = nil

local function effect(name: string)
	return CombatShared.template("Effects", name)
end

local function tweenAway(p: BasePart, time: number, goal)
	goal.Transparency = 1
	TweenService:Create(p, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
	Debris:AddItem(p, time + 0.1)
end

local function rootOf(model)
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return nil
	end
	return model:FindFirstChild("HumanoidRootPart")
end

local function ring(root: BasePart, style)
	local p = effect("Ring")
	if not p then
		return
	end
	p.Color = style.color
	p.CFrame = CFrame.new(root.Position - Vector3.new(0, 2.8, 0)) * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = Workspace.CurrentCamera
	tweenAway(p, style.time, { Size = Vector3.new(p.Size.X, style.size, style.size) })
end

local function flash(model: Model, style)
	local h = effect("Flash")
	if not h then
		return
	end
	h.FillColor = style.color
	h.OutlineColor = style.color
	h.Parent = model
	TweenService:Create(h, TweenInfo.new(style.time), { FillTransparency = 1, OutlineTransparency = 1 }):Play()
	Debris:AddItem(h, style.time + 0.05)
end

local function sphere(position: Vector3, color: Color3, fromSize: number, toSize: number, time: number)
	local p = effect("Sphere")
	if not p then
		return
	end
	p.Color = color
	p.Size = Vector3.one * fromSize
	p.CFrame = CFrame.new(position)
	p.Parent = Workspace.CurrentCamera
	tweenAway(p, time, { Size = Vector3.one * toSize })
end

local function box(cframe: CFrame, size: Vector3, ball: boolean)
	local p = effect(if ball then "Sphere" else "Hitbox")
	if not p then
		return
	end
	if ball then
		p.Material = Enum.Material.ForceField
		p.Color = Color3.fromRGB(255, 40, 40)
		p.Transparency = 0.75
	end
	p.Size = size
	p.CFrame = cframe
	p.Parent = Workspace.CurrentCamera
	Debris:AddItem(p, 0.3)
end

local function stepProjectiles(dt: number)
	for id, pr in pairs(projectiles) do
		local step = math.min(pr.speed * dt, pr.range - pr.traveled)
		pr.traveled += step
		pr.position += pr.direction * step
		pr.part.CFrame = CFrame.new(pr.position)
		if pr.traveled >= pr.range or os.clock() - pr.born > 10 then
			pr.part:Destroy()
			projectiles[id] = nil
		end
	end
	if next(projectiles) == nil and projectileConnection then
		projectileConnection:Disconnect()
		projectileConnection = nil
	end
end

function Effects.play(kind, model, ...)
	local root = rootOf(model)
	if kind == "hitbox" or kind == "hitsphere" then
		local cframe, size = ...
		if typeof(cframe) == "CFrame" and typeof(size) == "Vector3" then
			box(cframe, size, kind == "hitsphere")
		end
		return
	end
	if not root then
		return
	end
	if RINGS[kind] then
		ring(root, RINGS[kind])
	elseif FLASHES[kind] then
		flash(model, FLASHES[kind])
	elseif kind == "blast" then
		local center, element = ...
		if typeof(center) == "Vector3" then
			sphere(center, ELEMENT_COLORS[element] or Color3.new(1, 1, 1), 1.5, 6, 0.25)
		end
	elseif kind == "burst" then
		local radius, element = ...
		if type(radius) == "number" then
			sphere(root.Position, ELEMENT_COLORS[element] or Color3.new(1, 1, 1), 2, radius * 2, 0.4)
		end
	end
end

function Effects.projectile(id, origin, direction, speed, range, weaponName, config)
	if type(id) ~= "number" or typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" or type(speed) ~= "number" or type(range) ~= "number" then
		return
	end
	local p = effect("Projectile")
	if not p then
		return
	end
	local weapon = config.weapons[weaponName]
	local color = ELEMENT_COLORS[weapon and weapon.effect] or Color3.new(1, 1, 1)
	p.Color = color
	local light = p:FindFirstChildOfClass("PointLight")
	if light then
		light.Color = color
	end
	p.CFrame = CFrame.new(origin)
	p.Parent = Workspace.CurrentCamera
	projectiles[id] = { part = p, position = origin, direction = direction, speed = speed, range = range, traveled = 0, born = os.clock(), color = color }
	if not projectileConnection then
		projectileConnection = RunService.RenderStepped:Connect(stepProjectiles)
	end
end

function Effects.projectileEnd(id, position, exploded)
	local pr = projectiles[id]
	local color = if pr then pr.color else Color3.fromRGB(255, 120, 30)
	if pr then
		pr.part:Destroy()
		projectiles[id] = nil
	end
	if exploded and typeof(position) == "Vector3" then
		sphere(position, color, 2, 14, 0.4)
	end
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000023"><Properties><string name="Name">HudController</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local RunService = game:GetService("RunService")

local KEY_LABELS = {
	LeftControl = "CTRL",
	RightControl = "CTRL",
	LeftShift = "SHFT",
	RightShift = "SHFT",
	Space = "SPC",
}

local HudController = {}
HudController.__index = HudController

local function keyLabel(name: string): string
	return KEY_LABELS[name] or name
end

function HudController.new(ctx)
	local self = setmetatable({
		ctx = ctx,
		rows = {},
		gui = nil,
		list = nil,
		template = nil,
		weaponName = nil,
		skyUnlocked = nil,
		characterConnection = nil,
	}, HudController)

	local playerGui = ctx.player:WaitForChild("PlayerGui")
	local gui = playerGui:FindFirstChild("CombatHud")
	if not gui then
		local slow = task.delay(15, function()
			warn("[CombatSystem] still waiting for CombatHud in PlayerGui; is it in StarterGui?")
		end)
		gui = playerGui:WaitForChild("CombatHud")
		task.cancel(slow)
	end
	local list = gui and gui:FindFirstChild("AbilityList", true)
	local template = list and list:FindFirstChild("AbilityRow")
	if not template then
		warn("[CombatSystem] CombatHud (with AbilityList/AbilityRow) not found in StarterGui; the ability HUD is disabled.")
		return self
	end
	template.Visible = false
	self.gui, self.list, self.template = gui, list, template

	local function watchCharacter(character)
		if self.characterConnection then
			self.characterConnection:Disconnect()
		end
		self.characterConnection = character:GetAttributeChangedSignal("Weapon"):Connect(function()
			self:rebuild()
		end)
		self:rebuild()
	end
	ctx.player.CharacterAdded:Connect(watchCharacter)
	if ctx.player.Character then
		watchCharacter(ctx.player.Character)
	end
	ctx.player:GetAttributeChangedSignal("Unlock_skyJump"):Connect(function()
		self:rebuild()
	end)
	RunService.RenderStepped:Connect(function()
		self:update()
	end)
	self:rebuild()
	return self
end

function HudController:_entries()
	local ctx = self.ctx
	local keys = ctx.config.keys
	local weaponName, weapon = ctx.currentWeapon()
	local entries = {
		{ kind = "cooldown", id = "M1", key = "M1", title = "Attack" },
		{ kind = "block", key = keyLabel(keys.block), title = "Block" },
		{ kind = "cooldown", id = "Dash", key = keyLabel(keys.dash), title = "Dash" },
	}
	if ctx.hasUnlock("skyJump") then
		table.insert(entries, { kind = "cooldown", id = "SkyJump", key = keyLabel(keys.jump), title = "Sky Jump" })
	end
	if weapon then
		for _, ability in ipairs(weapon.abilities) do
			table.insert(entries, { kind = "cooldown", id = weaponName .. "." .. ability.id, key = keyLabel(ability.key), title = ability.name })
		end
	end
	return entries, weaponName
end

function HudController:rebuild()
	if not self.template then
		return
	end
	for _, row in ipairs(self.rows) do
		row.frame:Destroy()
	end
	table.clear(self.rows)
	local entries, weaponName = self:_entries()
	self.weaponName = weaponName
	for i, entry in ipairs(entries) do
		local frame = self.template:Clone()
		frame.Name = "AbilityRowActive"
		frame.LayoutOrder = i
		frame.Visible = true
		local key = frame:FindFirstChild("Key")
		local row = {
			frame = frame,
			entry = entry,
			title = frame:FindFirstChild("Title"),
			cooldown = key and key:FindFirstChild("Cooldown"),
			timer = key and key:FindFirstChild("Timer"),
		}
		local keyText = key and key:FindFirstChild("KeyLabel")
		if keyText then
			keyText.Text = entry.key
		end
		if row.title then
			row.title.Text = entry.title
		end
		frame.Parent = self.list
		table.insert(self.rows, row)
	end
	self:update()
end

local function setRow(row, fraction: number, timerText: string?, titleText: string?)
	if row.cooldown then
		row.cooldown.Size = UDim2.fromScale(1, math.clamp(fraction, 0, 1))
		row.cooldown.Visible = fraction > 0
	end
	if row.timer then
		row.timer.Visible = timerText ~= nil
		if timerText then
			row.timer.Text = timerText
		end
	end
	if row.title and titleText and row.title.Text ~= titleText then
		row.title.Text = titleText
	end
end

function HudController:update()
	local ctx = self.ctx
	local character = ctx.player.Character
	for _, row in ipairs(self.rows) do
		local entry = row.entry
		if entry.kind == "cooldown" then
			local remaining = ctx.cooldownRemaining(entry.id)
			local duration = ctx.cooldownDurations[entry.id] or 0
			if remaining > 0 and duration > 0 then
				setRow(row, remaining / duration, ("%.1f"):format(remaining))
			else
				setRow(row, 0, nil)
			end
		elseif entry.kind == "block" then
			local shield = character and character:GetAttribute("Shield") or 0
			local max = character and character:GetAttribute("ShieldMax") or 0
			local missing = if max > 0 then 1 - shield / max else 0
			local minRaise = ctx.config.block.minRaiseFraction
			local usable = max > 0 and shield / max >= minRaise
			setRow(row, if usable then 0 else missing, nil)
		end
	end
end

return HudController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000024"><Properties><string name="Name">MovementController</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))
local ClimbIndicator = require(script.Parent.ClimbIndicator)

local WALL_GAP = 0.6
local STICK_GAIN = 8
local MANTLE_UP = 35
local MANTLE_FORWARD = 12
local AIR_JUMP_DEBOUNCE = 0.1

local flat = CombatShared.flat

local MovementController = {}
MovementController.__index = MovementController

function MovementController.new(ctx)
	local keys = ctx.config.keys
	local self = setmetatable({
		ctx = ctx,
		character = nil,
		humanoid = nil,
		root = nil,
		attachment = nil,
		params = RaycastParams.new(),
		airJumps = 0,
		lastAirJumpAt = -math.huge,
		dashing = nil,
		climbing = nil,
		climbPending = false,
		ragdolled = false,
		ragdollReason = nil,
		charConnections = {},
		indicator = ClimbIndicator.new(ctx.config.hud.indicatorDistance),
		keys = {
			dash = CombatShared.keyCode(keys.dash),
			jump = CombatShared.keyCode(keys.jump),
			climb = CombatShared.keyCode(keys.climb),
		},
	}, MovementController)
	self.params.FilterType = Enum.RaycastFilterType.Exclude

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not self.root then
			return
		end
		local key = input.KeyCode
		if key == self.keys.dash then
			self:dash()
		elseif key == self.keys.jump then
			self:jump()
		elseif key == self.keys.climb then
			self:toggleClimb()
		end
	end)
	RunService.PreSimulation:Connect(function()
		self:step()
	end)
	return self
end

function MovementController:_clearCharacter()
	for _, c in ipairs(self.charConnections) do
		c:Disconnect()
	end
	table.clear(self.charConnections)
	self:_stopDash()
	if self.climbing then
		self:_endClimb("respawn")
	end
	self.indicator:hide()
	self.character, self.humanoid, self.root, self.attachment = nil, nil, nil, nil
	self.airJumps = 0
	self.climbPending = false
	self.ragdolled = false
	self.ragdollReason = nil
end

function MovementController:bind(character: Model)
	self:_clearCharacter()
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root or character.Parent == nil then
		return
	end
	self.character = character
	self.humanoid = humanoid
	self.root = root
	self.params.FilterDescendantsInstances = { character }
	local attachment = CombatShared.template("Physics", "CombatMovement")
	if attachment then
		attachment.Parent = root
	end
	self.attachment = attachment
	table.insert(self.charConnections, humanoid.StateChanged:Connect(function(_, new)
		if (new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running) and not self.climbing then
			self.airJumps = 0
		end
	end))
	table.insert(self.charConnections, humanoid.Died:Connect(function()
		self:_clearCharacter()
	end))
end

function MovementController:_alive(): boolean
	return self.humanoid ~= nil and self.humanoid.Health > 0 and self.root ~= nil and self.root.Parent ~= nil
end

function MovementController:_stopDash()
	if self.dashing then
		self.dashing.constraint:Destroy()
		self.dashing = nil
	end
end

function MovementController:dash()
	local ctx = self.ctx
	if not self:_alive() or self.climbing or self.ragdolled or self.dashing or ctx.combatState() ~= "Idle" then
		return
	end
	if ctx.cooldownRemaining("Dash") > 0 then
		return
	end
	local cfg = ctx.config.dash
	local distance = ctx.resolve(cfg.distance)
	local duration = ctx.resolve(cfg.duration)
	local dir = flat(self.humanoid.MoveDirection)
	if dir.Magnitude < 0.1 then
		dir = flat(self.root.CFrame.LookVector)
	end
	if dir.Magnitude < 1e-3 then
		return
	end
	dir = dir.Unit
	ctx.send("Dash")
	local dashCooldown = ctx.resolve(cfg.cooldown)
	ctx.setCooldown("Dash", ctx.now() + dashCooldown, dashCooldown)

	local constraint = self:_planeVelocity("CombatDash", dir * (distance / duration))
	if constraint then
		self.dashing = { constraint = constraint, untilTime = os.clock() + duration, brake = true }
	end
end

function MovementController:_planeVelocity(name: string, velocity: Vector3)
	if not self.attachment then
		return nil
	end
	local constraint = CombatShared.template("Physics", "PlaneVelocity")
	if not constraint then
		return nil
	end
	constraint.Name = name
	constraint.Attachment0 = self.attachment
	constraint.PlaneVelocity = Vector2.new(velocity.X, velocity.Z)
	constraint.Parent = self.root
	return constraint
end

function MovementController:_maxAirJumps(): number
	if self.ctx.hasUnlock("skyJump") then
		return math.huge
	end
	return 1
end

function MovementController:jump()
	if self.climbing then
		self:_climbJump()
		return
	end
	local ctx = self.ctx
	if not self:_alive() then
		return
	end
	local state = ctx.combatState()
	local fallRagdoll = self.ragdolled and self.ragdollReason == "fall"
	if not fallRagdoll and self.humanoid.FloorMaterial ~= Enum.Material.Air then
		return
	end
	if state ~= "Idle" and state ~= "Dashing" and not fallRagdoll then
		return
	end
	local cfg = ctx.config.jump
	if os.clock() - self.lastAirJumpAt < AIR_JUMP_DEBOUNCE or self.airJumps >= self:_maxAirJumps() then
		return
	end
	if self.airJumps >= 1 and ctx.cooldownRemaining("SkyJump") > 0 then
		return
	end
	self.airJumps += 1
	self.lastAirJumpAt = os.clock()
	local isSky = self.airJumps >= 2
	ctx.send("AirJump")
	if isSky then
		local skyCooldown = ctx.resolve(cfg.skyJump.cooldown)
		ctx.setCooldown("SkyJump", ctx.now() + skyCooldown, skyCooldown)
	end
	if self.ragdolled then
		self:_setRagdoll(false)
	end
	local power = if isSky then ctx.resolve(cfg.skyJump.power) else ctx.resolve(cfg.doubleJumpPower)
	local v = self.root.AssemblyLinearVelocity
	local horizontal = Vector3.new(v.X, 0, v.Z)
	if isSky then
		local dir = flat(self.humanoid.MoveDirection)
		horizontal = if dir.Magnitude > 0.1 then dir.Unit * ctx.resolve(cfg.skyJump.horizontalSpeed) else Vector3.zero
	end
	self.root.AssemblyLinearVelocity = Vector3.new(horizontal.X, power, horizontal.Z)
	self.humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	ctx.effects.play(if isSky then "skyJump" else "doubleJump", self.character)
end

function MovementController:_wallHit(direction: Vector3, origin: Vector3?)
	local reach = self.ctx.config.climb.reach + 1
	local hit = Workspace:Raycast(origin or self.root.Position, direction.Unit * reach, self.params)
	if hit and math.abs(hit.Normal.Y) <= 0.5 then
		return hit
	end
	return nil
end

function MovementController:toggleClimb()
	local ctx = self.ctx
	if self.climbing then
		ctx.send("Climb", false)
		self:_endClimb("released")
		return
	end
	if not self:_alive() or self.climbPending or self.ragdolled or ctx.combatState() ~= "Idle" or ctx.cooldownRemaining("Climb") > 0 then
		return
	end
	local look = flat(self.root.CFrame.LookVector)
	if look.Magnitude < 1e-3 or not self:_wallHit(look) then
		return
	end
	self.climbPending = true
	ctx.send("Climb", true)
	task.delay(2, function()
		self.climbPending = false
	end)
end

function MovementController:_startClimb(normal: Vector3, endsAt: number, duration: number)
	if not self:_alive() then
		return
	end
	local velocity = self.attachment and CombatShared.template("Physics", "VectorVelocity")
	local orientation = self.attachment and CombatShared.template("Physics", "ClimbOrientation")
	if not velocity or not orientation then
		if velocity then
			velocity:Destroy()
		end
		if orientation then
			orientation:Destroy()
		end
		self.ctx.send("Climb", false)
		return
	end
	self:_stopDash()
	local hum = self.humanoid
	hum.AutoRotate = false
	hum.PlatformStand = true

	velocity.Name = "CombatClimb"
	velocity.Attachment0 = self.attachment
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = self.root

	orientation.Name = "CombatClimb"
	orientation.Attachment0 = self.attachment
	orientation.CFrame = CFrame.lookAt(Vector3.zero, -flat(normal).Unit)
	orientation.Parent = self.root

	self.climbing = { normal = normal, endsAt = endsAt, duration = duration, velocity = velocity, orientation = orientation }
	self.airJumps = 0
	self.indicator:show(self.root)
	self.ctx.animator.startClimb(self.character)
end

function MovementController:_endClimb(reason: string)
	local climb = self.climbing
	if not climb then
		return
	end
	self.climbing = nil
	climb.velocity:Destroy()
	climb.orientation:Destroy()
	self.indicator:hide()
	if self.character then
		self.ctx.animator.stopClimb(self.character)
	end
	self.airJumps = 0
	local climbCooldown = self.ctx.config.climb.cooldown
	self.ctx.setCooldown("Climb", self.ctx.now() + climbCooldown, climbCooldown)
	local hum = self.humanoid
	if hum and hum.Parent then
		hum.PlatformStand = false
		hum.AutoRotate = true
		if reason ~= "respawn" and hum.Health > 0 then
			hum:ChangeState(Enum.HumanoidStateType.Freefall)
		end
	end
	return climb
end

function MovementController:_climbJump()
	local ctx = self.ctx
	local climb = self:_endClimb("jump")
	if not climb then
		return
	end
	ctx.send("ClimbJump")
	local cfg = ctx.config.climb
	local away = flat(climb.normal)
	away = if away.Magnitude > 1e-3 then away.Unit else Vector3.zero
	self.root.AssemblyLinearVelocity = away * ctx.resolve(cfg.jumpAwaySpeed) + Vector3.yAxis * ctx.resolve(cfg.jumpPower)
end

function MovementController:_stepClimb()
	local climb = self.climbing
	local ctx = self.ctx
	local cfg = ctx.config.climb
	local root = self.root
	local hit = self:_wallHit(-climb.normal)
	if hit then
		climb.normal = hit.Normal
		local facing = -flat(hit.Normal).Unit
		local right = facing:Cross(Vector3.yAxis)
		local distance = (root.Position - hit.Position):Dot(hit.Normal)
		local desired = root.Size.Z / 2 + WALL_GAP
		local up = (if UserInputService:IsKeyDown(Enum.KeyCode.W) then 1 else 0) - (if UserInputService:IsKeyDown(Enum.KeyCode.S) then 1 else 0)
		local side = (if UserInputService:IsKeyDown(Enum.KeyCode.D) then 1 else 0) - (if UserInputService:IsKeyDown(Enum.KeyCode.A) then 1 else 0)
		local move = Vector3.yAxis * up + right * side
		if move.Magnitude > 1 then
			move = move.Unit
		end
		climb.velocity.VectorVelocity = move * ctx.resolve(cfg.speed) - hit.Normal * (distance - desired) * STICK_GAIN
		climb.orientation.CFrame = CFrame.lookAt(Vector3.zero, facing)
	else
		local facing = -flat(climb.normal).Unit
		local feet = self:_wallHit(-climb.normal, root.Position - Vector3.new(0, 2.5, 0))
		ctx.send("Climb", false)
		self:_endClimb(if feet then "mantle" else "wall")
		if feet then
			root.AssemblyLinearVelocity = Vector3.yAxis * MANTLE_UP + facing * MANTLE_FORWARD
		end
		return
	end
	self.indicator:update((climb.endsAt - ctx.now()) / climb.duration)
end

function MovementController:_setRagdoll(on: boolean, reason: string?)
	self.ragdolled = on
	self.ragdollReason = if on then reason else nil
	local hum = self.humanoid
	if not hum or hum.Health <= 0 then
		return
	end
	if on then
		self:_stopDash()
		if self.climbing then
			self:_endClimb("ragdoll")
		end
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	else
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

function MovementController:_knockback(velocity: Vector3, duration: number)
	if not self:_alive() then
		return
	end
	self:_stopDash()
	if self.climbing then
		self:_endClimb("hit")
	end
	local constraint = self:_planeVelocity("CombatKnockback", velocity)
	if constraint then
		self.dashing = { constraint = constraint, untilTime = os.clock() + duration }
	end
	if velocity.Y > 0 then
		local v = self.root.AssemblyLinearVelocity
		self.root.AssemblyLinearVelocity = Vector3.new(v.X, velocity.Y, v.Z)
		self.humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	end
end

function MovementController:onServer(kind, ...)
	if kind == "dash" then
		local ok = ...
		if ok == false then
			self:_stopDash()
		end
	elseif kind == "airJump" then
		local ok, count = ...
		if type(count) == "number" then
			self.airJumps = count
		end
		if ok == false and self.ctx.combatState() == "Ragdoll" and not self.ragdolled then
			self:_setRagdoll(true, "fall")
		end
	elseif kind == "climb" then
		local on, a, b, c = ...
		self.climbPending = false
		if on == true and typeof(c) == "Vector3" and type(a) == "number" and type(b) == "number" then
			self:_startClimb(c, a, b)
		elseif on == false and self.climbing and a ~= "jump" and a ~= "released" then
			self:_endClimb(a)
		end
	elseif kind == "ragdoll" then
		local on, reason = ...
		if on == true then
			self:_setRagdoll(true, reason)
		elseif on == false and self.ragdolled then
			self:_setRagdoll(false)
		end
	elseif kind == "knockback" then
		local velocity, duration = ...
		if typeof(velocity) == "Vector3" and type(duration) == "number" then
			self:_knockback(velocity, duration)
		end
	elseif kind == "correction" then
		self:_stopDash()
		if self.climbing then
			self:_endClimb("correction")
		end
	elseif kind == "synced" then
		local _, airJumps = ...
		if type(airJumps) == "number" then
			self.airJumps = airJumps
		end
	end
end

function MovementController:step()
	if not self.root then
		return
	end
	if self.dashing and os.clock() >= self.dashing.untilTime then
		local brake = self.dashing.brake
		self:_stopDash()
		if brake and self:_alive() then
			local v = self.root.AssemblyLinearVelocity
			local horizontal = Vector3.new(v.X, 0, v.Z)
			local limit = self.humanoid.WalkSpeed
			if horizontal.Magnitude > limit then
				horizontal = horizontal.Unit * limit
				self.root.AssemblyLinearVelocity = Vector3.new(horizontal.X, v.Y, horizontal.Z)
			end
		end
	end
	if self.climbing then
		if self:_alive() then
			self:_stepClimb()
		else
			self:_endClimb("respawn")
		end
	end
end

return MovementController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000025"><Properties><string name="Name">ProceduralAnimator</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))

local JOINTS = {
	[Enum.HumanoidRigType.R6] = {
		torso = { "HumanoidRootPart", "RootJoint" },
		head = { "Torso", "Neck" },
		rightArm = { "Torso", "Right Shoulder" },
		leftArm = { "Torso", "Left Shoulder" },
		rightLeg = { "Torso", "Right Hip" },
		leftLeg = { "Torso", "Left Hip" },
	},
	[Enum.HumanoidRigType.R15] = {
		torso = { "UpperTorso", "Waist" },
		head = { "Head", "Neck" },
		rightArm = { "RightUpperArm", "RightShoulder" },
		leftArm = { "LeftUpperArm", "LeftShoulder" },
		rightLeg = { "RightUpperLeg", "RightHip" },
		leftLeg = { "LeftUpperLeg", "LeftHip" },
	},
}

local ZERO = { 0, 0, 0 }
local CLIMB_MIN_SPEED = 1
local CLIMB_CYCLE_RATE = 1.4
local CLIMB_BLEND = 0.12
local GUARD_BLEND = 0.08
local GUARD_POSE = {
	rightArm = { 128, 0, -34 },
	leftArm = { 88, 0, 62 },
}

local ProceduralAnimator = {}

local playing = {}
local motorState = setmetatable({}, { __mode = "k" })
local loadedTracks = setmetatable({}, { __mode = "k" })
local connection = nil

local function findMotors(model: Model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local map = JOINTS[humanoid.RigType]
	if not map then
		return nil
	end
	local motors = {}
	for joint, path in pairs(map) do
		local part = model:FindFirstChild(path[1])
		local motor = part and part:FindFirstChild(path[2])
		if motor and (motor:IsA("Motor6D") or motor:IsA("AnimationConstraint")) then
			motors[joint] = motor
		end
	end
	return motors
end

local function ease(a: number): number
	if a < 0.5 then
		return 2 * a * a
	end
	return 1 - (-2 * a + 2) ^ 2 / 2
end

local function sample(keyframes, t: number)
	local count = #keyframes
	if t <= keyframes[1].t then
		return keyframes[1].pose, keyframes[1].pose, 0
	end
	for i = 1, count - 1 do
		local a, b = keyframes[i], keyframes[i + 1]
		if t >= a.t and t <= b.t then
			local span = b.t - a.t
			local alpha = if span > 0 then (t - a.t) / span else 1
			return a.pose, b.pose, ease(alpha)
		end
	end
	local last = keyframes[count].pose
	return last, last, 0
end

local function blendAngles(a, b, alpha: number)
	a = a or ZERO
	b = b or ZERO
	return math.rad(a[1] + (b[1] - a[1]) * alpha), math.rad(a[2] + (b[2] - a[2]) * alpha), math.rad(a[3] + (b[3] - a[3]) * alpha)
end

local function same(a: CFrame, b: CFrame): boolean
	return (a.Position - b.Position).Magnitude < 1e-3 and a.RightVector:Dot(b.RightVector) > 0.99999 and a.UpVector:Dot(b.UpVector) > 0.99999
end

local function restore(motor: Motor6D)
	local st = motorState[motor]
	if st and same(motor.Transform, st.applied) then
		motor.Transform = st.base
	end
	motorState[motor] = nil
end

local function jointRotation(motor): CFrame
	if motor:IsA("Motor6D") then
		return motor.C0.Rotation
	end
	local a0 = motor.Attachment0
	return if a0 then a0.CFrame.Rotation else CFrame.identity
end

local function apply(motor, x: number, y: number, z: number, absolute: boolean?)
	local st = motorState[motor]
	local base = motor.Transform
	if st and same(base, st.applied) then
		base = st.base
	end
	if absolute then
		base = CFrame.identity
	end
	local rot = jointRotation(motor)
	local offset = rot:Inverse() * CFrame.fromEulerAnglesYXZ(x, y, z) * rot
	local applied = offset * base
	motor.Transform = applied
	motorState[motor] = { base = base, applied = applied }
end

local function finish(model: Model)
	local track = playing[model]
	if not track then
		return
	end
	playing[model] = nil
	for _, motor in pairs(track.motors) do
		restore(motor)
	end
end

local function climbPose(track, dt: number, root: BasePart)
	local v = root.AssemblyLinearVelocity
	local lateral = Vector3.new(v.X, 0, v.Z).Magnitude
	if lateral < CLIMB_MIN_SPEED then
		lateral = 0
	end
	local vertical = if math.abs(v.Y) < CLIMB_MIN_SPEED then 0 else v.Y
	track.phase += (vertical + lateral) * dt * CLIMB_CYCLE_RATE
	local s = math.sin(track.phase)
	return {
		rightArm = { 158 + 24 * s, 0, 14 },
		leftArm = { 158 - 24 * s, 0, -14 },
		rightLeg = { 32 - 24 * s, 0, 8 },
		leftLeg = { 32 + 24 * s, 0, -8 },
		torso = { -4, 5 * s, 0 },
		head = { -18, 0, 0 },
	}
end

local function stepHeld(model: Model, track, now: number)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		finish(model)
		return
	end
	local dt = math.min(now - track.last, 0.1)
	track.last = now
	local target = if track.stopping then 0 else 1
	track.weight = math.clamp(track.weight + (target - track.weight) * math.min(1, dt / (if track.guard then GUARD_BLEND else CLIMB_BLEND)), 0, 1)
	if track.stopping and track.weight < 0.02 then
		finish(model)
		return
	end
	local pose = if track.guard then GUARD_POSE else climbPose(track, dt, root)
	for joint, motor in pairs(track.motors) do
		local angles = pose[joint]
		if angles then
			local x, y, z = blendAngles(ZERO, angles, track.weight)
			apply(motor, x, y, z, true)
		else
			restore(motor)
		end
	end
end

local function step()
	local now = os.clock()
	for model, track in pairs(playing) do
		if track.climb or track.guard then
			if not model.Parent then
				finish(model)
			else
				stepHeld(model, track, now)
			end
			continue
		end
		local elapsed = (now - track.start) * track.speed
		if not model.Parent or elapsed >= track.animation.duration then
			finish(model)
			continue
		end
		local from, to, alpha = sample(track.animation.keyframes, elapsed)
		for joint, motor in pairs(track.motors) do
			if from[joint] or to[joint] then
				apply(motor, blendAngles(from[joint], to[joint], alpha))
			else
				restore(motor)
			end
		end
	end
end

local function playAsset(model: Model, id: string, speed: number): boolean
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return false
	end
	local cache = loadedTracks[animator]
	if not cache then
		cache = {}
		loadedTracks[animator] = cache
	end
	local track = cache[id]
	if not track then
		local animation = CombatShared.template("Physics", "Animation")
		if not animation then
			return false
		end
		animation.AnimationId = id
		local ok, result = pcall(animator.LoadAnimation, animator, animation)
		if not ok then
			warn(("[CombatSystem] could not load animation %s: %s"):format(id, tostring(result)))
			return false
		end
		track = result
		cache[id] = track
	end
	track:Play(0.05, 1, speed)
	return true
end

function ProceduralAnimator.play(model: Model, animation, speed: number?)
	if type(animation) ~= "table" then
		return
	end
	speed = speed or 1
	if type(animation.id) == "string" and animation.id ~= "" and playAsset(model, animation.id, speed) then
		return
	end
	if type(animation.keyframes) ~= "table" or #animation.keyframes == 0 or type(animation.duration) ~= "number" then
		return
	end
	local current = playing[model]
	if current and current.climb then
		return
	end
	finish(model)
	local motors = findMotors(model)
	if not motors then
		return
	end
	playing[model] = { animation = animation, start = os.clock(), speed = speed, motors = motors }
	if not connection then
		connection = RunService.PreSimulation:Connect(step)
	end
end

function ProceduralAnimator.startClimb(model: Model)
	local current = playing[model]
	if current and current.climb then
		current.stopping = false
		return
	end
	local motors = findMotors(model)
	if not motors then
		return
	end
	finish(model)
	playing[model] = { climb = true, motors = motors, phase = 0, weight = 0, last = os.clock(), stopping = false }
	if not connection then
		connection = RunService.PreSimulation:Connect(step)
	end
end

function ProceduralAnimator.stopClimb(model: Model)
	local current = playing[model]
	if current and current.climb then
		current.stopping = true
	end
end

function ProceduralAnimator.startGuard(model: Model)
	local current = playing[model]
	if current and current.guard then
		current.stopping = false
		return
	end
	if current and current.climb then
		return
	end
	local motors = findMotors(model)
	if not motors then
		return
	end
	finish(model)
	playing[model] = { guard = true, motors = motors, weight = 0, last = os.clock(), stopping = false }
	if not connection then
		connection = RunService.PreSimulation:Connect(step)
	end
end

function ProceduralAnimator.stopGuard(model: Model)
	local current = playing[model]
	if current and current.guard then
		current.stopping = true
	end
end

function ProceduralAnimator.stop(model: Model)
	finish(model)
end

return ProceduralAnimator
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000026"><Properties><string name="Name">ShieldIndicator</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local FULL = Color3.fromRGB(150, 205, 255)
local MID = Color3.fromRGB(255, 215, 90)
local LOW = Color3.fromRGB(255, 80, 80)

local ShieldIndicator = {}
ShieldIndicator.__index = ShieldIndicator

local MIN_SCALE = 0.05
local MAX_SCALE = 8

function ShieldIndicator.new(distance: number, widthStuds: number)
	return setmetatable({ active = {}, warned = false, distance = distance, widthStuds = widthStuds, connection = nil }, ShieldIndicator)
end

function ShieldIndicator:_clone(model: Model)
	local template = ReplicatedStorage:FindFirstChild("ShieldIndicator")
	if not template or not template:IsA("BillboardGui") then
		if not self.warned then
			self.warned = true
			warn("[CombatSystem] ShieldIndicator (BillboardGui) not found in ReplicatedStorage; the shield icon is disabled.")
		end
		return nil
	end
	local adornee = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	local holderTemplate = template:FindFirstChild("Holder")
	local slot = holderTemplate and holderTemplate:FindFirstChild("Slot")
	local fill = slot and slot:FindFirstChild("Fill")
	if not adornee or not fill then
		if not adornee then
			return nil
		end
		if not self.warned then
			self.warned = true
			warn("[CombatSystem] ShieldIndicator is missing Holder/Slot/Fill; the shield icon is disabled.")
		end
		return nil
	end
	local gui = template:Clone()
	gui.Adornee = adornee
	gui.Enabled = true
	gui.ResetOnSpawn = false
	gui.MaxDistance = self.distance
	local holder = gui.Holder
	local clonedFill = holder.Slot.Fill
	local paints = {}
	for _, d in ipairs(clonedFill:GetDescendants()) do
		if d:IsA("Frame") and d.Name == "Paint" then
			table.insert(paints, d)
		end
	end
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return { gui = gui, fill = clonedFill, paints = paints, scale = holder:FindFirstChildOfClass("UIScale"), root = adornee, baseWidth = math.max(holder.Size.X.Offset, 1), baseHeight = math.max(holder.Size.Y.Offset, 1) }
end

function ShieldIndicator:_scaleFor(entry, camera: Camera): number
	local distance = math.max((camera.CFrame.Position - entry.root.Position).Magnitude, 0.5)
	local pixelsPerStud = camera.ViewportSize.Y / (2 * distance * math.tan(math.rad(camera.FieldOfView) / 2))
	return math.clamp(self.widthStuds * pixelsPerStud / entry.baseWidth, MIN_SCALE, MAX_SCALE)
end

local function applyScale(entry, value: number)
	if entry.scale then
		entry.scale.Scale = value
	end
	entry.gui.Size = UDim2.fromOffset(math.ceil(entry.baseWidth * value) + 4, math.ceil(entry.baseHeight * value) + 4)
end

function ShieldIndicator:_rescale()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	for _, entry in pairs(self.active) do
		if entry.root.Parent then
			applyScale(entry, self:_scaleFor(entry, camera))
		end
	end
end

function ShieldIndicator:_ensureLoop()
	if self.connection then
		return
	end
	self.connection = RunService.RenderStepped:Connect(function()
		if next(self.active) == nil then
			self.connection:Disconnect()
			self.connection = nil
			return
		end
		self:_rescale()
	end)
end

function ShieldIndicator:_paint(entry, model: Model, instant: boolean?)
	local shield = model:GetAttribute("Shield") or 0
	local max = model:GetAttribute("ShieldMax") or 0
	local ratio = if max > 0 then math.clamp(shield / max, 0, 1) else 0
	local color = if ratio > 0.5 then FULL elseif ratio > 0.25 then MID else LOW
	local size = UDim2.new(1, 0, ratio, 0)
	if instant then
		entry.fill.Size = size
	else
		TweenService:Create(entry.fill, TweenInfo.new(0.12), { Size = size }):Play()
	end
	for _, paint in ipairs(entry.paints) do
		paint.BackgroundColor3 = color
	end
end

function ShieldIndicator:set(model, on: boolean)
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return
	end
	local entry = self.active[model]
	if on then
		if entry then
			return
		end
		entry = self:_clone(model)
		if not entry then
			return
		end
		entry.connections = {
			model:GetAttributeChangedSignal("Shield"):Connect(function()
				self:_paint(entry, model)
			end),
			model.AncestryChanged:Connect(function()
				if not model.Parent then
					self:set(model, false)
				end
			end),
		}
		self.active[model] = entry
		self:_paint(entry, model, true)
		self:_rescale()
		self:_ensureLoop()
	elseif entry then
		self.active[model] = nil
		for _, c in ipairs(entry.connections) do
			c:Disconnect()
		end
		entry.gui:Destroy()
	end
end

function ShieldIndicator:shatter(model)
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return
	end
	self:set(model, false)
	local entry = self:_clone(model)
	if not entry then
		return
	end
	entry.fill.Size = UDim2.fromScale(1, 1)
	local camera = Workspace.CurrentCamera
	if camera then
		applyScale(entry, self:_scaleFor(entry, camera))
	end
	for _, paint in ipairs(entry.paints) do
		paint.BackgroundColor3 = LOW
	end
	local info = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	for _, d in ipairs(entry.gui:GetDescendants()) do
		if d:IsA("Frame") then
			TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
		end
	end
	TweenService:Create(entry.gui.Holder, info, { Position = UDim2.new(0.5, 0, 0.5, 8) }):Play()
	Debris:AddItem(entry.gui, 0.5)
end

return ShieldIndicator
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterCharacterScripts" referent="RBXBASE000102"><Properties><string name="Name">StarterCharacterScripts</string></Properties></Item></Item>
