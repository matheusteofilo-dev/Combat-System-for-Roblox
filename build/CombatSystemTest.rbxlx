			{ windup = 0.15, recovery = 0.22, hitbox = HITBOX, damage = damage(8, 0.1), animation = SIDE_RIGHT },
			{ windup = 0.15, recovery = 0.22, hitbox = HITBOX, damage = damage(8, 0.1), animation = SIDE_LEFT },
