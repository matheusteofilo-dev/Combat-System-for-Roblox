	<Item class="ServerScriptService" referent="RBXBASE000005"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBXCS000017"><Properties><string name="Name">CombatBootstrap</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local ServerScriptService = game:GetService("ServerScriptService")

local CombatSystem = require(ServerScriptService:WaitForChild("CombatSystem"))

local ok, err = pcall(CombatSystem.Start)
if not ok then
	warn(err)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000007"><Properties><string name="Name">CombatSystem</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local config = require(ReplicatedStorage:WaitForChild("CombatConfig"))
local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))
local Validator = require(script.ConfigValidator)
local Combatant = require(script.Combatant)
local StatsService = require(script.StatsService)
local MovementAuthority = require(script.MovementAuthority)
local BlockService = require(script.BlockService)
local HitService = require(script.HitService)
local AttackService = require(script.AttackService)
local NPCService = require(script.NPCService)

local MAX_ACTION_ARGS = 4
local MAX_STRING_LENGTH = 32

local CombatSystem = {}
CombatSystem.config = config
CombatSystem.StatsChanged = CombatShared.newSignal()
CombatSystem.CombatantAdded = CombatShared.newSignal()
CombatSystem.CombatantRemoved = CombatShared.newSignal()
CombatSystem.Damaged = CombatShared.newSignal()

local started = false
local combatants = {}
local connections = {}
local playerConnections = {}
local actionHandlers = {}
local actionBudget = {}
local weapons = {}
local npcProfiles = {}
local stats = nil
local movement = nil
local blocks = nil
local hits = nil
local attacks = nil
local npcs = nil
local actionRemote = nil
local stateRemote = nil
local warnedWeapons = {}
local registerBuiltInActions

local function log(msg: string)
	print("[CombatSystem] " .. msg)
end

local function weaponFromCharacter(character: Model): string
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			local name = child:GetAttribute("Weapon")
			if name == nil and weapons[child.Name] then
				name = child.Name
			end
			if weapons[name] then
				return name
			end
			if name ~= nil and not warnedWeapons[name] then
				warnedWeapons[name] = true
				warn(("[CombatSystem] tool %s has Weapon = '%s', which is not a valid weapon; using %s."):format(child:GetFullName(), tostring(name), config.defaultWeapon))
			end
		end
	end
	return config.defaultWeapon
end

function CombatSystem.Send(player: Player, ...)
	if stateRemote and player.Parent then
		stateRemote:FireClient(player, ...)
	end
end

function CombatSystem.Broadcast(origin: Vector3, ...)
	if not stateRemote then
		return
	end
	local range = config.network.animationRange
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and (root.Position - origin).Magnitude <= range then
			stateRemote:FireClient(player, ...)
		end
	end
end

local debugPlayers = {}

local function debugAllowed(player: Player): boolean
	local cfg = config.debug
	if not cfg.enabled then
		return false
	end
	if cfg.studioOnly and RunService:IsStudio() then
		return true
	end
	return table.find(cfg.userIds, player.UserId) ~= nil
end

function CombatSystem.SendDebug(...)
	if not stateRemote then
		return
	end
	for player in pairs(debugPlayers) do
		if player.Parent then
			stateRemote:FireClient(player, ...)
		else
			debugPlayers[player] = nil
		end
	end
end

local function removeCombatant(model: Model, reason: string)
	local c = combatants[model]
	if not c then
		return
	end
	combatants[model] = nil
	if movement then
		movement:forget(c)
	end
	c:destroy()
	CombatSystem.CombatantRemoved:Fire(c, reason)
end

local function addCombatant(model: Model, humanoid: Humanoid, root: BasePart, options)
	removeCombatant(model, "replaced")
	options.config = config
	local c = Combatant.new(model, humanoid, root, options)
	combatants[model] = c
	table.insert(c.connections, humanoid.Died:Connect(function()
		removeCombatant(model, "died")
	end))
	table.insert(c.connections, model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(Workspace) then
			removeCombatant(model, "removed from workspace")
		end
	end))
	if c.player then
		local player = c.player
		table.insert(c.connections, c.changed:Connect(function(kind, id, untilTime, duration)
			if kind == "cooldown" and combatants[model] == c then
				CombatSystem.Send(player, "cooldown", id, untilTime, duration)
			end
		end))
	end
	CombatSystem.CombatantAdded:Fire(c)
	return c
end

local function hookCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not started or player.Character ~= character then
		return
	end
	if not humanoid or not root then
		warn(("[CombatSystem] %s has no Humanoid/HumanoidRootPart; combat disabled for this character."):format(character:GetFullName()))
		return
	end
	local c = addCombatant(character, humanoid, root, {
		player = player,
		weapon = weaponFromCharacter(character),
		statsProvider = function()
			return stats:get(player)
		end,
		unlockProvider = function(key)
			return stats:getUnlock(player, key)
		end,
	})
	local function refreshWeapon(child)
		if child:IsA("Tool") and combatants[character] == c then
			c:setWeapon(weaponFromCharacter(character))
		end
	end
	table.insert(c.connections, character.ChildAdded:Connect(refreshWeapon))
	table.insert(c.connections, character.ChildRemoved:Connect(refreshWeapon))
end

local function addPlayer(player: Player)
	local list = {}
	playerConnections[player] = list
	table.insert(list, player.CharacterAdded:Connect(function(character)
		hookCharacter(player, character)
	end))
	if player.Character then
		task.spawn(hookCharacter, player, player.Character)
	end
end

local function removePlayer(player: Player)
	local list = playerConnections[player]
	if list then
		for _, c in ipairs(list) do
			c:Disconnect()
		end
	end
	playerConnections[player] = nil
	actionBudget[player] = nil
	debugPlayers[player] = nil
end

local function allowAction(player: Player): boolean
	local now = os.clock()
	local budget = actionBudget[player]
	if not budget or now - budget.windowStart >= 1 then
		budget = { windowStart = now, count = 0 }
		actionBudget[player] = budget
	end
	budget.count += 1
	return budget.count <= config.network.maxActionsPerSecond
end

local function argsAreSafe(count: number, ...): boolean
	if count > MAX_ACTION_ARGS then
		return false
	end
	for i = 1, count do
		local v = select(i, ...)
		local t = type(v)
		if t == "string" then
			if #v > MAX_STRING_LENGTH then
				return false
			end
		elseif t == "number" then
			if not CombatShared.isFinite(v) or math.abs(v) > 1000 then
				return false
			end
		elseif t ~= "boolean" and t ~= "nil" then
			return false
		end
	end
	return true
end

local function onAction(player: Player, action, ...)
	if type(action) ~= "string" or #action > MAX_STRING_LENGTH then
		return
	end
	if not allowAction(player) then
		return
	end
	local handler = actionHandlers[action]
	if not handler then
		return
	end
	if not argsAreSafe(select("#", ...), ...) then
		return
	end
	local character = player.Character
	local c = character and combatants[character]
	if not c or c.player ~= player or not c:isAlive() then
		return
	end
	local ok, err = xpcall(handler, debug.traceback, c, ...)
	if not ok then
		warn(("[CombatSystem] action '%s' from %s failed: %s"):format(action, player.Name, tostring(err)))
	end
end

function CombatSystem.RegisterAction(name: string, handler)
	if actionHandlers[name] then
		warn(("[CombatSystem] action '%s' registered twice; the last one wins."):format(name))
	end
	actionHandlers[name] = handler
end

local function step(dt: number)
	local now = Combatant.now()
	for _, c in pairs(table.clone(combatants)) do
		local ok, err = xpcall(c.update, debug.traceback, c, now, dt)
		if ok and movement and combatants[c.model] == c then
			ok, err = xpcall(movement.update, debug.traceback, movement, c, now, dt)
		end
		if not ok then
			warn(("[CombatSystem] update error on %s: %s"):format(c.model.Name, tostring(err)))
		end
	end
	if attacks then
		local ok, err = xpcall(attacks.update, debug.traceback, attacks, dt)
		if not ok then
			warn("[CombatSystem] projectile update error: " .. tostring(err))
		end
	end
	if npcs then
		local ok, err = xpcall(npcs.update, debug.traceback, npcs, now)
		if not ok then
			warn("[CombatSystem] NPC update error: " .. tostring(err))
		end
	end
end

function registerBuiltInActions()
	CombatSystem.RegisterAction("Debug", function(c, on)
		if type(on) ~= "boolean" then
			return
		end
		local allowed = on and debugAllowed(c.player)
		debugPlayers[c.player] = if allowed then true else nil
		CombatSystem.Send(c.player, "debug", allowed)
	end)
	CombatSystem.RegisterAction("DebugUnlock", function(c, key, on)
		if not debugPlayers[c.player] or type(key) ~= "string" or type(on) ~= "boolean" then
			return
		end
		if config.stats.unlocks[key] == nil then
			return
		end
		CombatSystem.SetUnlock(c.player, key, on)
	end)
	CombatSystem.RegisterAction("Sync", function(c)
		local now = Combatant.now()
		for id, untilTime in pairs(c.cooldowns) do
			if untilTime > now then
				CombatSystem.Send(c.player, "cooldown", id, untilTime, untilTime - now)
			end
		end
		CombatSystem.Send(c.player, "synced", c.state, c.airJumps)
	end)
end
registerBuiltInActions()

function CombatSystem.Start()
	if started then
		return
	end
	for name, weapon in pairs(config.weapons) do
		local errors = Validator.validateWeapon(name, weapon, config)
		if #errors == 0 then
			weapons[name] = weapon
		else
			warn(("[CombatSystem] weapon '%s' disabled:\n  - %s"):format(tostring(name), table.concat(errors, "\n  - ")))
		end
	end
	local errors = Validator.validateGlobal(config)
	if #errors > 0 then
		table.clear(weapons)
		error("[CombatSystem] invalid global configuration:\n  - " .. table.concat(errors, "\n  - "), 0)
	end
	for tag, npc in pairs(config.npcs) do
		local npcErrors = Validator.validateNPC(tag, npc, config, weapons)
		if #npcErrors == 0 then
			npcProfiles[tag] = npc
		else
			warn(("[CombatSystem] NPC profile '%s' disabled:\n  - %s"):format(tostring(tag), table.concat(npcErrors, "\n  - ")))
		end
	end

	local remotes = ReplicatedStorage:FindFirstChild("CombatRemotes")
	actionRemote = remotes and remotes:FindFirstChild("CombatAction")
	stateRemote = remotes and remotes:FindFirstChild("CombatState")
	if not (actionRemote and actionRemote:IsA("RemoteEvent") and stateRemote and stateRemote:IsA("RemoteEvent")) then
		actionRemote, stateRemote = nil, nil
		warn("[CombatSystem] CombatRemotes (CombatAction, CombatState) not found in ReplicatedStorage; player input is disabled, NPC combat still works.")
	end

	started = true
	local api = {
		RegisterAction = CombatSystem.RegisterAction,
		Send = CombatSystem.Send,
		Broadcast = CombatSystem.Broadcast,
		SendDebug = CombatSystem.SendDebug,
		now = Combatant.now,
		GetWeapon = CombatSystem.GetWeapon,
		GetCombatant = CombatSystem.GetCombatant,
		GetCombatants = CombatSystem.GetCombatants,
		Damaged = CombatSystem.Damaged,
	}
	movement = MovementAuthority.new(api, config)
	blocks = BlockService.new(api, config)
	hits = HitService.new(api, config, movement, blocks)
	blocks.hit = hits
	attacks = AttackService.new(api, config, hits)
	stats = StatsService.new(config)
	table.insert(connections, stats.changed:Connect(function(player, kind, key, value)
		local character = player.Character
		local c = character and combatants[character]
		if c then
			c:refreshDerived(false)
		end
		CombatSystem.StatsChanged:Fire(player, kind, key, value)
	end))
	stats:start()

	if actionRemote then
		table.insert(connections, actionRemote.OnServerEvent:Connect(onAction))
	end
	for _, player in ipairs(Players:GetPlayers()) do
		addPlayer(player)
	end
	table.insert(connections, Players.PlayerAdded:Connect(addPlayer))
	table.insert(connections, Players.PlayerRemoving:Connect(removePlayer))
	table.insert(connections, RunService.Heartbeat:Connect(step))
	npcs = NPCService.new(CombatSystem, config, npcProfiles)
	npcs:start()
	log("started")
end

function CombatSystem.Stop()
	if not started then
		return
	end
	started = false
	if npcs then
		npcs:stop()
		npcs = nil
	end
	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	table.clear(connections)
	for player in pairs(table.clone(playerConnections)) do
		removePlayer(player)
	end
	for model in pairs(table.clone(combatants)) do
		removeCombatant(model, "system stopped")
	end
	if stats then
		stats:stop()
		stats = nil
	end
	if attacks then
		attacks:clear()
	end
	movement, blocks, hits, attacks = nil, nil, nil, nil
	table.clear(actionHandlers)
	registerBuiltInActions()
	table.clear(weapons)
	table.clear(npcProfiles)
end

function CombatSystem.ResetMovementGuard(model: Instance, grace: number?)
	local c = combatants[model]
	if c and movement then
		movement:resetGuard(c, grace)
	end
end

function CombatSystem.GrantMovement(model: Instance, horizontalSpeed: number, rise: number, duration: number)
	local c = combatants[model]
	if c and movement and CombatShared.isFinite(horizontalSpeed) and CombatShared.isFinite(rise) and CombatShared.isFinite(duration) then
		movement:grant(c, horizontalSpeed, rise, duration)
	end
end

function CombatSystem.GetMovement()
	return movement
end

function CombatSystem.GetServices()
	return { movement = movement, block = blocks, hit = hits, attack = attacks }
end

function CombatSystem.RegisterNPC(model: Model, tag: string)
	local profile = npcProfiles[tag]
	if not started or not profile then
		return nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		warn(("[CombatSystem] %s has no Humanoid/root part; NPC combat disabled."):format(model:GetFullName()))
		return nil
	end
	local npcStats = table.clone(config.stats.defaults)
	if profile.stats then
		for key, value in pairs(profile.stats) do
			npcStats[key] = value
		end
	end
	npcStats = table.freeze(npcStats)
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	return addCombatant(model, humanoid, root, {
		weapon = profile.weapon,
		statsProvider = function()
			return npcStats
		end,
		unlockProvider = function()
			return false
		end,
	})
end

function CombatSystem.GetNPCProfile(tag: string)
	return npcProfiles[tag]
end

function CombatSystem.GetWeapon(name: string)
	return weapons[name]
end

function CombatSystem.GetCombatant(model: Instance)
	return combatants[model]
end

function CombatSystem.GetCombatants()
	local list = {}
	for _, c in pairs(combatants) do
		table.insert(list, c)
	end
	return list
end

function CombatSystem.GetStats(player: Player)
	return stats and stats:get(player)
end

function CombatSystem.SetStat(player: Player, key: string, value: number): boolean
	return stats ~= nil and stats:set(player, key, value)
end

function CombatSystem.AddStat(player: Player, key: string, delta: number): boolean
	return stats ~= nil and stats:add(player, key, delta)
end

function CombatSystem.GetUnlock(player: Player, key: string): boolean
	return stats ~= nil and stats:getUnlock(player, key)
end

function CombatSystem.SetUnlock(player: Player, key: string, value: boolean): boolean
	return stats ~= nil and stats:setUnlock(player, key, value)
end

function CombatSystem.IsStatsLoaded(player: Player): boolean
	return stats ~= nil and stats:isLoaded(player)
end

return CombatSystem
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBXCS000008"><Properties><string name="Name">AttackService</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))

local flat = CombatShared.flat

local MAX_PITCH = 1.45

local AttackService = {}
AttackService.__index = AttackService

function AttackService.cooldownId(weaponName: string, abilityId: string): string
	return weaponName .. "." .. abilityId
end

function AttackService.new(api, config, hit)
	local self = setmetatable({
		api = api,
		config = config,
		hit = hit,
		projectiles = {},
		nextProjectileId = 0,
	}, AttackService)
	api.RegisterAction("M1", function(c)
		c.aimDirection = nil
		self:m1(c)
	end)
	api.RegisterAction("Ability", function(c, id, yaw, pitch)
		if type(id) ~= "string" then
			return
		end
		local ability = self:findAbility(c.weapon, id)
		if ability and ability.kind == "projectile" then
			self:_readAim(c, yaw, pitch)
		else
			c.aimDirection = nil
		end
		self:ability(c, id)
	end)
	return self
end

function AttackService:_readAim(c, yaw, pitch)
	if CombatShared.isFinite(yaw) and CombatShared.isFinite(pitch) then
		c.aimDirection = CombatShared.aimDirection(yaw, math.clamp(pitch, -MAX_PITCH, MAX_PITCH))
	else
		c.aimDirection = nil
	end
end

function AttackService:_aim(c): Vector3
	local aim = c.aimDirection
	if typeof(aim) == "Vector3" and aim.Magnitude > 1e-3 then
		return aim.Unit
	end
	local look = flat(c.root.CFrame.LookVector)
	return if look.Magnitude > 1e-3 then look.Unit else Vector3.new(0, 0, -1)
end

function AttackService:_frame(c, aim: Vector3): CFrame
	local direction = flat(aim)
	if direction.Magnitude < 0.2 then
		return c.root.CFrame
	end
	local position = c.root.Position
	return CFrame.lookAt(position, position + direction.Unit)
end

function AttackService:m1(c): boolean
	if not c:canAct() or c.state ~= "Idle" or not c:isReady("M1") then
		return false
	end
	local weapon = self.api.GetWeapon(c.weapon)
	if not weapon then
		return false
	end
	local m1 = weapon.m1
	local now = self.api.now()
	if now - c.lastM1At > m1.comboResetTime or c.comboWeapon ~= c.weapon then
		c.combo = 0
	end
	local index = c.combo % #m1.hits + 1
	c.combo = index
	c.comboWeapon = c.weapon
	c.lastM1At = now
	local attack = m1.hits[index]
	local total = attack.windup + attack.recovery
	if index == #m1.hits then
		c.combo = 0
		c:startCooldown("M1", total + m1.comboEndCooldown)
	else
		c:startCooldown("M1", total)
	end
	self:perform(c, attack, c.weapon, "m1", index)
	return true
end

function AttackService:findAbility(weaponName: string, id: string)
	local weapon = self.api.GetWeapon(weaponName)
	if not weapon then
		return nil
	end
	for _, ability in ipairs(weapon.abilities) do
		if ability.id == id then
			return ability
		end
	end
	return nil
end

function AttackService:ability(c, id: string): boolean
	if not c:canAct() or c.state ~= "Idle" then
		return false
	end
	local ability = self:findAbility(c.weapon, id)
	if not ability then
		return false
	end
	local key = AttackService.cooldownId(c.weapon, id)
	if not c:isReady(key) then
		return false
	end
	c:startCooldown(key, c:resolve(ability.cooldown))
	self:perform(c, ability, c.weapon, "ability", id)
	return true
end

function AttackService:perform(c, attack, weaponName: string, kind: string, key)
	local total = attack.windup + attack.recovery
	c:setState("Attacking", total)
	c.attackToken = (c.attackToken or 0) + 1
	local token = c.attackToken
	local aim = self:_aim(c)
	self.api.Broadcast(c.root.Position, "anim", c.model, weaponName, kind, key)
	task.delay(attack.windup, function()
		if c.attackToken ~= token or c.state ~= "Attacking" or not c:isAlive() then
			return
		end
		self:_release(c, attack, weaponName, aim)
	end)
end

function AttackService:_release(c, attack, weaponName: string, aim: Vector3)
	local weapon = self.api.GetWeapon(weaponName)
	local effect = weapon and weapon.effect
	local kind = attack.kind or "melee"
	if kind == "melee" then
		local frame = self:_frame(c, aim)
		local center = (frame * attack.hitbox.offset).Position
		if effect then
			self.api.Broadcast(center, "fx", "blast", c.model, center, effect)
		end
		for _, target in ipairs(self.hit:queryBox(c, attack.hitbox, frame)) do
			self.hit:apply(c, target, attack, c.root.Position)
		end
	elseif kind == "area" then
		local center = c.root.Position
		self.api.Broadcast(center, "fx", "burst", c.model, attack.area.radius, effect)
		for _, target in ipairs(self.hit:queryRadius(c, center, attack.area.radius)) do
			self.hit:apply(c, target, attack, center)
		end
	elseif kind == "projectile" then
		self:_spawnProjectile(c, attack, weaponName, aim)
	end
end

function AttackService:_spawnProjectile(c, attack, weaponName: string, direction: Vector3)
	local p = attack.projectile
	local origin = c.root.Position + direction * 2 + Vector3.new(0, 0.5, 0)
	self.nextProjectileId += 1
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { c.model }
	local projectile = {
		id = self.nextProjectileId,
		owner = c,
		attack = attack,
		position = origin,
		direction = direction,
		traveled = 0,
		params = params,
	}
	table.insert(self.projectiles, projectile)
	self.api.Broadcast(origin, "projectile", projectile.id, origin, direction, p.speed, p.range, weaponName)
end

function AttackService:_explode(projectile, position: Vector3, hitPart: BasePart?)
	local owner = projectile.owner
	local attack = projectile.attack
	local radius = attack.projectile.explosionRadius
	local targets = {}
	if radius > 0 then
		targets = self.hit:queryRadius(owner, position, radius)
	elseif hitPart then
		local model = hitPart:FindFirstAncestorOfClass("Model")
		local target = model and self.api.GetCombatant(model)
		if target and self.hit:canHit(owner, target) then
			targets = { target }
		end
	end
	for _, target in ipairs(targets) do
		self.hit:apply(owner, target, attack, position)
	end
	self.api.Broadcast(position, "projectileEnd", projectile.id, position, true)
end

function AttackService:update(dt: number)
	for i = #self.projectiles, 1, -1 do
		local pr = self.projectiles[i]
		local spec = pr.attack.projectile
		local step = math.min(spec.speed * dt, spec.range - pr.traveled)
		local result = if step > 0 then Workspace:Spherecast(pr.position, spec.radius, pr.direction * step, pr.params) else nil
		if result then
			table.remove(self.projectiles, i)
			self:_explode(pr, result.Position + result.Normal * 0.5, result.Instance)
		else
			pr.position += pr.direction * step
			pr.traveled += step
			if pr.traveled >= spec.range - 1e-3 then
				table.remove(self.projectiles, i)
				self.api.Broadcast(pr.position, "projectileEnd", pr.id, pr.position, false)
			end
		end
	end
end

function AttackService:clear()
	table.clear(self.projectiles)
end

return AttackService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000009"><Properties><string name="Name">BlockService</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local BlockService = {}
BlockService.__index = BlockService

function BlockService.new(api, config)
	local self = setmetatable({ api = api, config = config, hit = nil }, BlockService)
	api.RegisterAction("Block", function(c, on)
		if on == true then
			self:raise(c)
		elseif on == false then
			self:lower(c)
		end
	end)
	return self
end

function BlockService:raise(c): boolean
	if not c:canAct() or c.state ~= "Idle" then
		return false
	end
	if c.shield < c.shieldMax * self.config.block.minRaiseFraction then
		return false
	end
	c:setState("Blocking")
	return true
end

function BlockService:lower(c)
	if c.state == "Blocking" then
		c:setState("Idle")
	end
end

function BlockService:absorb(c, damage: number): boolean
	c.lastShieldHitAt = self.api.now()
	local remaining = c.shield - damage
	if remaining > 1e-6 then
		c:setShield(remaining)
		return false
	end
	self:breakGuard(c, "depleted")
	return true
end

function BlockService:breakGuard(c, reason: string)
	c.lastShieldHitAt = self.api.now()
	c:setShield(0)
	self.api.Broadcast(c.root.Position, "fx", "guardBreak", c.model, reason)
	self.hit:stun(c, c:resolve(self.config.block.guardBreakStun), "guardBreak")
end

return BlockService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000010"><Properties><string name="Name">Combatant</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))

local HISTORY_SIZE = 30
local HISTORY_INTERVAL = 0.1

local Combatant = {}
Combatant.__index = Combatant

local function now(): number
	return Workspace:GetServerTimeNow()
end
Combatant.now = now

function Combatant.new(model: Model, humanoid: Humanoid, root: BasePart, options)
	local self = setmetatable({
		model = model,
		humanoid = humanoid,
		root = root,
		player = options.player,
		isNPC = options.player == nil,
		config = options.config,
		statsProvider = options.statsProvider,
		unlockProvider = options.unlockProvider,
		weapon = options.weapon,
		state = "Idle",
		stateUntil = nil,
		cooldowns = {},
		shield = 0,
		shieldMax = 0,
		lastShieldHitAt = -math.huge,
		airJumps = 0,
		combo = 0,
		lastM1At = -math.huge,
		history = {},
		lastHistoryAt = -math.huge,
		destroyed = false,
		changed = CombatShared.newSignal(),
		connections = {},
		lastPublished = {},
	}, Combatant)
	self:refreshDerived(true)
	self:_publish("CombatState", self.state)
	self:_publish("Weapon", self.weapon)
	CollectionService:AddTag(model, CombatShared.ACTOR_TAG)
	return self
end

function Combatant:getStats()
	return self.statsProvider()
end

function Combatant:hasUnlock(key: string): boolean
	return self.unlockProvider ~= nil and self.unlockProvider(key) == true
end

function Combatant:resolve(value)
	return CombatShared.resolve(value, self:getStats())
end

function Combatant:_publish(name: string, value)
	if self.lastPublished[name] == value then
		return
	end
	self.lastPublished[name] = value
	self.model:SetAttribute(name, value)
end

function Combatant:isAlive(): boolean
	return not self.destroyed and self.model.Parent ~= nil and self.humanoid.Health > 0
end

function Combatant:canAct(): boolean
	return self:isAlive() and self.state ~= "Stunned" and self.state ~= "Ragdoll"
end

function Combatant:isBusy(): boolean
	return self.state ~= "Idle"
end

function Combatant:setState(state: string, duration: number?)
	local old = self.state
	self.state = state
	self.stateUntil = if duration then now() + duration else nil
	self:_publish("CombatState", state)
	if old ~= state then
		self.changed:Fire("state", state, old)
	end
end

function Combatant:clearState(state: string)
	if self.state == state then
		self:setState("Idle")
	end
end

function Combatant:cooldownRemaining(id: string): number
	local untilTime = self.cooldowns[id]
	if not untilTime then
		return 0
	end
	return math.max(0, untilTime - now())
end

function Combatant:isReady(id: string): boolean
	return self:cooldownRemaining(id) <= 0
end

function Combatant:startCooldown(id: string, duration: number)
	if duration <= 0 then
		return
	end
	local untilTime = now() + duration
	self.cooldowns[id] = untilTime
	self.changed:Fire("cooldown", id, untilTime, duration)
end

function Combatant:setWeapon(name: string)
	if self.weapon == name then
		return
	end
	self.weapon = name
	self.combo = 0
	self:_publish("Weapon", name)
	self.changed:Fire("weapon", name)
end

function Combatant:refreshDerived(fill: boolean?)
	local cfg = self.config
	local maxShield = self:resolve(cfg.block.max)
	local ratio = if self.shieldMax > 0 then self.shield / self.shieldMax else 1
	self.shieldMax = maxShield
	self.shield = if fill then maxShield else math.clamp(maxShield * ratio, 0, maxShield)
	self:_publish("ShieldMax", math.floor(self.shieldMax + 0.5))
	self:_publish("Shield", math.floor(self.shield + 0.5))

	local maxHealth = self:resolve(cfg.health.max)
	local hum = self.humanoid
	if hum.MaxHealth ~= maxHealth then
		local healthRatio = if hum.MaxHealth > 0 then hum.Health / hum.MaxHealth else 1
		hum.MaxHealth = maxHealth
		if fill then
			hum.Health = maxHealth
		elseif hum.Health > 0 then
			hum.Health = math.clamp(maxHealth * healthRatio, 0.01, maxHealth)
		end
	end
end

function Combatant:setShield(value: number)
	self.shield = math.clamp(value, 0, self.shieldMax)
	self:_publish("Shield", math.floor(self.shield + 0.5))
end

function Combatant:recordPosition(t: number)
	if t - self.lastHistoryAt < HISTORY_INTERVAL then
		return
	end
	self.lastHistoryAt = t
	table.insert(self.history, { time = t, position = self.root.Position, cframe = self.root.CFrame })
	if #self.history > HISTORY_SIZE then
		table.remove(self.history, 1)
	end
end

function Combatant:positionAt(t: number): CFrame
	local history = self.history
	for i = #history, 1, -1 do
		if history[i].time <= t then
			return history[i].cframe
		end
	end
	return self.root.CFrame
end

function Combatant:update(t: number, dt: number)
	if not self:isAlive() then
		return
	end
	self:recordPosition(t)
	if self.stateUntil and t >= self.stateUntil then
		self.stateUntil = nil
		self:setState("Idle")
	end
	if self.state ~= "Blocking" and self.state ~= "Stunned" and self.shield < self.shieldMax and t - self.lastShieldHitAt >= self.config.block.regenDelay then
		self:setShield(self.shield + self:resolve(self.config.block.regenRate) * dt)
	end
end

function Combatant:destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	for _, c in ipairs(self.connections) do
		c:Disconnect()
	end
	table.clear(self.connections)
	if self.model.Parent then
		self.model:SetAttribute("CombatState", nil)
		CollectionService:RemoveTag(self.model, CombatShared.ACTOR_TAG)
	end
end

return Combatant
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000011"><Properties><string name="Name">ConfigValidator</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))

local Validator = {}

local isFinite = CombatShared.isFinite

local function checkNumber(errors, path, value, min, max, minExclusive)
	if not isFinite(value) then
		table.insert(errors, ("%s must be a finite number (got %s)"):format(path, tostring(value)))
		return false
	end
	if min ~= nil and ((minExclusive and value <= min) or (not minExclusive and value < min)) then
		table.insert(errors, ("%s must be %s %s (got %s)"):format(path, if minExclusive then ">" else ">=", tostring(min), tostring(value)))
		return false
	end
	if max ~= nil and value > max then
		table.insert(errors, ("%s must be <= %s (got %s)"):format(path, tostring(max), tostring(value)))
		return false
	end
	return true
end

local function checkValue(errors, path, value, stats, min, max, minExclusive)
	if type(value) == "function" then
		local ok, result = pcall(value, stats)
		if not ok then
			table.insert(errors, ("%s errored with default stats: %s"):format(path, tostring(result)))
			return false
		end
		return checkNumber(errors, path .. "(defaults)", result, min, max, minExclusive)
	end
	return checkNumber(errors, path, value, min, max, minExclusive)
end

local function checkBool(errors, path, value)
	if type(value) ~= "boolean" then
		table.insert(errors, ("%s must be a boolean (got %s)"):format(path, tostring(value)))
		return false
	end
	return true
end

local function checkString(errors, path, value)
	if type(value) ~= "string" or value == "" then
		table.insert(errors, ("%s must be a non-empty string (got %s)"):format(path, tostring(value)))
		return false
	end
	return true
end

local function checkTable(errors, path, value)
	if type(value) ~= "table" then
		table.insert(errors, ("%s must be a table (got %s)"):format(path, type(value)))
		return false
	end
	return true
end

local function checkKey(errors, path, value)
	if not CombatShared.keyCode(value) then
		table.insert(errors, ("%s must be an Enum.KeyCode name (got %s)"):format(path, tostring(value)))
		return false
	end
	return true
end

local function checkAnimation(errors, path, anim)
	if anim == nil then
		return
	end
	if not checkTable(errors, path, anim) then
		return
	end
	if anim.id ~= nil and type(anim.id) ~= "string" then
		table.insert(errors, path .. ".id must be a string")
	end
	if anim.keyframes ~= nil then
		checkNumber(errors, path .. ".duration", anim.duration, 0, nil, true)
		if checkTable(errors, path .. ".keyframes", anim.keyframes) then
			local last = -math.huge
			for i, kf in ipairs(anim.keyframes) do
				local kp = ("%s.keyframes[%d]"):format(path, i)
				if checkTable(errors, kp, kf) and checkNumber(errors, kp .. ".t", kf.t, 0) then
					if kf.t < last then
						table.insert(errors, kp .. ".t must not be lower than the previous keyframe")
					end
					last = kf.t
					checkTable(errors, kp .. ".pose", kf.pose)
				end
			end
		end
	end
end

local function checkAttack(errors, path, attack, stats)
	if not checkTable(errors, path, attack) then
		return
	end
	checkNumber(errors, path .. ".windup", attack.windup, 0)
	checkNumber(errors, path .. ".recovery", attack.recovery, 0)
	checkValue(errors, path .. ".damage", attack.damage, stats, 0)
	if attack.knockback ~= nil then
		checkValue(errors, path .. ".knockback", attack.knockback, stats, 0)
	end
	if attack.launch ~= nil then
		checkValue(errors, path .. ".launch", attack.launch, stats, 0)
	end
	if attack.breaksBlock ~= nil then
		checkBool(errors, path .. ".breaksBlock", attack.breaksBlock)
	end
	local kind = attack.kind or "melee"
	if kind == "melee" then
		if checkTable(errors, path .. ".hitbox", attack.hitbox) then
			if typeof(attack.hitbox.size) ~= "Vector3" then
				table.insert(errors, path .. ".hitbox.size must be a Vector3")
			end
			if typeof(attack.hitbox.offset) ~= "CFrame" then
				table.insert(errors, path .. ".hitbox.offset must be a CFrame")
			end
		end
	elseif kind == "projectile" then
		if checkTable(errors, path .. ".projectile", attack.projectile) then
			local p = attack.projectile
			checkNumber(errors, path .. ".projectile.speed", p.speed, 0, nil, true)
			checkNumber(errors, path .. ".projectile.range", p.range, 0, nil, true)
			checkNumber(errors, path .. ".projectile.radius", p.radius, 0, nil, true)
			checkNumber(errors, path .. ".projectile.explosionRadius", p.explosionRadius, 0)
		end
	elseif kind == "area" then
		if checkTable(errors, path .. ".area", attack.area) then
			checkNumber(errors, path .. ".area.radius", attack.area.radius, 0, nil, true)
		end
	else
		table.insert(errors, ("%s.kind must be \"melee\", \"projectile\" or \"area\" (got %s)"):format(path, tostring(kind)))
	end
	checkAnimation(errors, path .. ".animation", attack.animation)
end

function Validator.validateWeapon(name, weapon, config)
	local errors = {}
	local p = "weapons." .. tostring(name)
	local stats = config.stats.defaults
	if not checkTable(errors, p, weapon) then
		return errors
	end
	checkString(errors, p .. ".displayName", weapon.displayName)
	if checkTable(errors, p .. ".m1", weapon.m1) then
		local m1 = weapon.m1
		checkNumber(errors, p .. ".m1.comboResetTime", m1.comboResetTime, 0)
		checkNumber(errors, p .. ".m1.comboEndCooldown", m1.comboEndCooldown, 0)
		if checkTable(errors, p .. ".m1.hits", m1.hits) then
			if #m1.hits == 0 then
				table.insert(errors, p .. ".m1.hits must have at least one hit")
			end
			for i, hit in ipairs(m1.hits) do
				checkAttack(errors, ("%s.m1.hits[%d]"):format(p, i), hit, stats)
			end
		end
	end
	local globalKeys = {}
	for _, key in pairs(config.keys) do
		globalKeys[key] = true
	end
	if checkTable(errors, p .. ".abilities", weapon.abilities) then
		local ids, keys = {}, {}
		for i, ability in ipairs(weapon.abilities) do
			local ap = ("%s.abilities[%d]"):format(p, i)
			if checkTable(errors, ap, ability) then
				if checkString(errors, ap .. ".id", ability.id) then
					if CombatShared.RESERVED_ACTIONS[ability.id] then
						table.insert(errors, ap .. ".id uses a reserved name: " .. ability.id)
					elseif ids[ability.id] then
						table.insert(errors, ap .. ".id is duplicated: " .. ability.id)
					end
					ids[ability.id] = true
				end
				checkString(errors, ap .. ".name", ability.name)
				if checkKey(errors, ap .. ".key", ability.key) then
					if globalKeys[ability.key] then
						table.insert(errors, ap .. ".key conflicts with config.keys: " .. ability.key)
					elseif keys[ability.key] then
						table.insert(errors, ap .. ".key is used twice in this weapon: " .. ability.key)
					end
					keys[ability.key] = true
				end
				checkValue(errors, ap .. ".cooldown", ability.cooldown, stats, 0)
				checkAttack(errors, ap, ability, stats)
			end
		end
	end
	return errors
end

function Validator.validateNPC(tag, npc, config, weapons)
	local errors = {}
	local p = "npcs." .. tostring(tag)
	if not checkTable(errors, p, npc) then
		return errors
	end
	local weapon = weapons[npc.weapon]
	if not weapon then
		table.insert(errors, ("%s.weapon '%s' is not a valid weapon"):format(p, tostring(npc.weapon)))
	end
	local behavior = npc.behavior
	if behavior ~= "idle" and behavior ~= "block" and behavior ~= "attack" then
		table.insert(errors, p .. ".behavior must be \"idle\", \"block\" or \"attack\"")
	end
	local known = { M1 = true }
	if weapon then
		for _, ability in ipairs(weapon.abilities) do
			known[ability.id] = true
		end
	end
	if behavior == "attack" then
		if npc.abilityMode ~= "random" and npc.abilityMode ~= "sequence" then
			table.insert(errors, p .. ".abilityMode must be \"random\" or \"sequence\"")
		end
		if npc.abilityMode == "sequence" then
			if checkTable(errors, p .. ".sequence", npc.sequence) and #npc.sequence == 0 then
				table.insert(errors, p .. ".sequence must not be empty")
			end
		end
		checkNumber(errors, p .. ".range", npc.range, 0, nil, true)
		checkBool(errors, p .. ".attackWithoutTarget", npc.attackWithoutTarget)
	end
	if npc.sequence ~= nil and type(npc.sequence) == "table" then
		for i, id in ipairs(npc.sequence) do
			if not known[id] then
				table.insert(errors, ("%s.sequence[%d] '%s' is not M1 or an ability of %s"):format(p, i, tostring(id), tostring(npc.weapon)))
			end
		end
	end
	if npc.weights ~= nil and checkTable(errors, p .. ".weights", npc.weights) then
		for id, w in pairs(npc.weights) do
			if not known[id] then
				table.insert(errors, ("%s.weights.%s is not M1 or an ability of %s"):format(p, tostring(id), tostring(npc.weapon)))
			end
			checkNumber(errors, p .. ".weights." .. tostring(id), w, 0)
		end
	end
	if npc.interval ~= nil and checkTable(errors, p .. ".interval", npc.interval) then
		local r = npc.interval
		if checkNumber(errors, p .. ".interval[1]", r[1], 0) and checkNumber(errors, p .. ".interval[2]", r[2], 0) and r[2] < r[1] then
			table.insert(errors, p .. ".interval[2] must be >= interval[1]")
		end
	end
	if npc.stats ~= nil and checkTable(errors, p .. ".stats", npc.stats) then
		for key, v in pairs(npc.stats) do
			if config.stats.defaults[key] == nil then
				table.insert(errors, ("%s.stats.%s is not a stat in config.stats.defaults"):format(p, tostring(key)))
			end
			checkNumber(errors, p .. ".stats." .. tostring(key), v)
		end
	end
	if npc.respawnTime ~= nil then
		checkNumber(errors, p .. ".respawnTime", npc.respawnTime, 0)
	end
	return errors
end

function Validator.validateGlobal(config)
	local errors = {}
	if not checkTable(errors, "config.stats", config.stats) then
		return errors
	end
	local s = config.stats
	checkString(errors, "stats.dataStoreName", s.dataStoreName)
	checkString(errors, "stats.studioDataStoreName", s.studioDataStoreName)
	if s.dataStoreName == s.studioDataStoreName then
		table.insert(errors, "stats.studioDataStoreName must differ from stats.dataStoreName (Studio must never touch live data)")
	end
	checkBool(errors, "stats.saveInStudio", s.saveInStudio)
	checkNumber(errors, "stats.autosaveInterval", s.autosaveInterval, 30)
	checkNumber(errors, "stats.sessionLockTimeout", s.sessionLockTimeout, 30)
	checkNumber(errors, "stats.loadAttempts", s.loadAttempts, 1)
	checkNumber(errors, "stats.retryDelay", s.retryDelay, 0)
	if checkTable(errors, "stats.defaults", s.defaults) then
		for key, v in pairs(s.defaults) do
			checkNumber(errors, "stats.defaults." .. tostring(key), v)
		end
	end
	if checkTable(errors, "stats.unlocks", s.unlocks) then
		for key, v in pairs(s.unlocks) do
			checkBool(errors, "stats.unlocks." .. tostring(key), v)
		end
	end
	local stats = s.defaults or {}

	if checkTable(errors, "keys", config.keys) then
		local seen = {}
		for name, key in pairs(config.keys) do
			if checkKey(errors, "keys." .. name, key) then
				if seen[key] then
					table.insert(errors, ("keys.%s uses the same key as keys.%s"):format(name, seen[key]))
				end
				seen[key] = name
			end
		end
	end

	local function group(name)
		return checkTable(errors, name, config[name]) and config[name]
	end

	local n = group("network")
	if n then
		checkNumber(errors, "network.maxActionsPerSecond", n.maxActionsPerSecond, 1)
		checkNumber(errors, "network.animationRange", n.animationRange, 0, nil, true)
	end
	local h = group("health")
	if h then
		checkValue(errors, "health.max", h.max, stats, 0, nil, true)
	end
	local r = group("run")
	if r then
		checkValue(errors, "run.walkSpeed", r.walkSpeed, stats, 0)
		checkValue(errors, "run.speed", r.speed, stats, 0)
		checkBool(errors, "run.cancelOnAction", r.cancelOnAction)
		checkNumber(errors, "run.doubleTapWindow", r.doubleTapWindow, 0.05)
	end
	local d = group("dash")
	if d then
		checkValue(errors, "dash.distance", d.distance, stats, 0, nil, true)
		checkValue(errors, "dash.duration", d.duration, stats, 0, nil, true)
		checkValue(errors, "dash.cooldown", d.cooldown, stats, 0)
		checkBool(errors, "dash.iFrames", d.iFrames)
	end
	local j = group("jump")
	if j then
		checkValue(errors, "jump.doubleJumpPower", j.doubleJumpPower, stats, 0, nil, true)
		if checkTable(errors, "jump.skyJump", j.skyJump) then
			checkValue(errors, "jump.skyJump.power", j.skyJump.power, stats, 0, nil, true)
			checkValue(errors, "jump.skyJump.horizontalSpeed", j.skyJump.horizontalSpeed, stats, 0)
			checkValue(errors, "jump.skyJump.cooldown", j.skyJump.cooldown, stats, 0)
		end
	end
	local b = group("block")
	if b then
		checkNumber(errors, "block.arc", b.arc, 0, 360, true)
		checkValue(errors, "block.max", b.max, stats, 0, nil, true)
		checkNumber(errors, "block.regenDelay", b.regenDelay, 0)
		checkValue(errors, "block.regenRate", b.regenRate, stats, 0)
		checkValue(errors, "block.walkSpeed", b.walkSpeed, stats, 0)
		checkValue(errors, "block.guardBreakStun", b.guardBreakStun, stats, 0)
		checkNumber(errors, "block.minRaiseFraction", b.minRaiseFraction, 0, 1)
		checkBool(errors, "block.showToOthers", b.showToOthers)
	end
	local hit = group("hit")
	if hit then
		checkValue(errors, "hit.hitStun", hit.hitStun, stats, 0)
		checkNumber(errors, "hit.reachTolerance", hit.reachTolerance, 0)
		checkNumber(errors, "hit.maxTargets", hit.maxTargets, 1)
		checkBool(errors, "hit.pvp", hit.pvp)
		checkBool(errors, "hit.npcFriendlyFire", hit.npcFriendlyFire)
		checkBool(errors, "hit.lineOfSight", hit.lineOfSight)
		checkNumber(errors, "hit.knockbackTime", hit.knockbackTime, 0.05)
	end
	local dbg = group("debug")
	if dbg then
		checkBool(errors, "debug.showHitboxes", dbg.showHitboxes)
		checkBool(errors, "debug.enabled", dbg.enabled)
		checkBool(errors, "debug.studioOnly", dbg.studioOnly)
		if type(dbg.userIds) ~= "table" then
			table.insert(errors, "debug.userIds must be a table of user ids")
		end
	end
	local hud = group("hud")
	if hud then
		checkNumber(errors, "hud.indicatorDistance", hud.indicatorDistance, 5)
		checkNumber(errors, "hud.shieldWidthStuds", hud.shieldWidthStuds, 0.2)
	end
	local c = group("climb")
	if c then
		checkNumber(errors, "climb.reach", c.reach, 0, nil, true)
		checkValue(errors, "climb.time", c.time, stats, 0, nil, true)
		checkValue(errors, "climb.speed", c.speed, stats, 0, nil, true)
		checkNumber(errors, "climb.ragdollFallHeight", c.ragdollFallHeight, 0)
		checkNumber(errors, "climb.cooldown", c.cooldown, 0)
		checkValue(errors, "climb.jumpPower", c.jumpPower, stats, 0)
		checkValue(errors, "climb.jumpAwaySpeed", c.jumpAwaySpeed, stats, 0)
		checkNumber(errors, "climb.wallCheckInterval", c.wallCheckInterval, 0.05)
		checkNumber(errors, "climb.wallMisses", c.wallMisses, 1)
	end
	local rg = group("ragdoll")
	if rg then
		checkNumber(errors, "ragdoll.minTime", rg.minTime, 0)
		checkNumber(errors, "ragdoll.maxTime", rg.maxTime, 0, nil, true)
	end
	local a = group("anticheat")
	if a then
		checkBool(errors, "anticheat.enabled", a.enabled)
		checkNumber(errors, "anticheat.speedTolerance", a.speedTolerance, 1)
		checkNumber(errors, "anticheat.horizontalSlack", a.horizontalSlack, 0)
		checkNumber(errors, "anticheat.teleportDistance", a.teleportDistance, 0, nil, true)
		checkNumber(errors, "anticheat.verticalTolerance", a.verticalTolerance, 1)
		checkNumber(errors, "anticheat.verticalSlack", a.verticalSlack, 0)
		checkNumber(errors, "anticheat.spawnGrace", a.spawnGrace, 0)
	end

	if checkTable(errors, "weapons", config.weapons) then
		local def = config.weapons[config.defaultWeapon]
		if not def then
			table.insert(errors, ("defaultWeapon '%s' is not in weapons"):format(tostring(config.defaultWeapon)))
		elseif #Validator.validateWeapon(config.defaultWeapon, def, config) > 0 then
			table.insert(errors, ("defaultWeapon '%s' is invalid (see the weapon warning)"):format(config.defaultWeapon))
		end
	end
	checkTable(errors, "npcs", config.npcs)
	return errors
end

return Validator
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000012"><Properties><string name="Name">HitService</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))

local flat = CombatShared.flat

local HitService = {}
HitService.__index = HitService

function HitService.new(api, config, movement, block)
	return setmetatable({
		api = api,
		config = config,
		movement = movement,
		block = block,
	}, HitService)
end

function HitService:canHit(attacker, target): boolean
	if attacker == target or not target:isAlive() then
		return false
	end
	local cfg = self.config.hit
	if not attacker.isNPC and not target.isNPC and not cfg.pvp then
		return false
	end
	if attacker.isNPC and target.isNPC and not cfg.npcFriendlyFire then
		return false
	end
	return true
end

function HitService:_overlapParams(attacker)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { attacker.model }
	return params
end

function HitService:hasLineOfSight(from: Vector3, target, ignore): boolean
	if not self.config.hit.lineOfSight then
		return true
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local list = { target.model }
	for _, model in ipairs(ignore) do
		table.insert(list, model)
	end
	for _, c in ipairs(self.api.GetCombatants()) do
		table.insert(list, c.model)
	end
	params.FilterDescendantsInstances = list
	local to = target.root.Position
	return Workspace:Raycast(from, to - from, params) == nil
end

function HitService:_collect(attacker, parts, origin: Vector3, ignore)
	local found, list = {}, {}
	for _, part in ipairs(parts) do
		local model = part:FindFirstAncestorOfClass("Model")
		while model and not self.api.GetCombatant(model) do
			model = model:FindFirstAncestorOfClass("Model")
		end
		local target = model and self.api.GetCombatant(model)
		if target and not found[target] and self:canHit(attacker, target) then
			found[target] = true
			if self:hasLineOfSight(origin, target, ignore) then
				table.insert(list, target)
			end
		end
	end
	table.sort(list, function(a, b)
		return (a.root.Position - origin).Magnitude < (b.root.Position - origin).Magnitude
	end)
	local max = self.config.hit.maxTargets
	while #list > max do
		table.remove(list)
	end
	return list
end

function HitService:queryBox(attacker, hitbox, frame: CFrame?)
	local tol = self.config.hit.reachTolerance
	local cframe = (frame or attacker.root.CFrame) * hitbox.offset
	local size = hitbox.size + Vector3.new(tol, tol * 0.5, tol)
	if self.config.debug.showHitboxes then
		self.api.Broadcast(cframe.Position, "fx", "hitbox", attacker.model, cframe, size)
	else
		self.api.SendDebug("fx", "hitbox", attacker.model, cframe, size)
	end
	local parts = Workspace:GetPartBoundsInBox(cframe, size, self:_overlapParams(attacker))
	return self:_collect(attacker, parts, attacker.root.Position, { attacker.model })
end

function HitService:queryRadius(attacker, center: Vector3, radius: number)
	local r = radius + self.config.hit.reachTolerance * 0.5
	if self.config.debug.showHitboxes then
		self.api.Broadcast(center, "fx", "hitsphere", attacker.model, CFrame.new(center), Vector3.one * r * 2)
	else
		self.api.SendDebug("fx", "hitsphere", attacker.model, CFrame.new(center), Vector3.one * r * 2)
	end
	local parts = Workspace:GetPartBoundsInRadius(center, r, self:_overlapParams(attacker))
	return self:_collect(attacker, parts, center, { attacker.model })
end

function HitService:stun(target, duration: number, reason: string)
	if duration <= 0 or not target:isAlive() or target.state == "Ragdoll" then
		return
	end
	if target.state == "Climbing" then
		self.movement:stopClimb(target, "hit")
	elseif target.state == "Blocking" then
		self.block:_announce(target, false)
	end
	target:setState("Stunned", duration)
	target.attackToken = (target.attackToken or 0) + 1
	self.api.Broadcast(target.root.Position, "fx", "stun", target.model, duration, reason)
end

function HitService:knockback(target, source: Vector3, horizontal: number, vertical: number)
	if horizontal <= 0 and vertical <= 0 then
		return
	end
	local dir = flat(target.root.Position - source)
	dir = if dir.Magnitude > 1e-3 then dir.Unit else flat(-target.root.CFrame.LookVector).Unit
	local velocity = dir * horizontal + Vector3.yAxis * vertical
	local duration = self.config.hit.knockbackTime + vertical / Workspace.Gravity * 2
	if target.isNPC then
		target.root.AssemblyLinearVelocity = velocity
	else
		self.movement:grant(target, horizontal + target.humanoid.WalkSpeed, vertical * vertical / (2 * Workspace.Gravity), duration + 0.5)
		self.api.Send(target.player, "knockback", velocity, self.config.hit.knockbackTime)
	end
end

function HitService:apply(attacker, target, attack, source: Vector3)
	if not self:canHit(attacker, target) then
		return "invalid"
	end
	local now = self.api.now()
	if target.invulnerableUntil and now < target.invulnerableUntil then
		self.api.Broadcast(target.root.Position, "fx", "dodge", target.model)
		return "dodged"
	end

	local damage = math.max(0, attacker:resolve(attack.damage))
	local front = CombatShared.isInFront(target.root.CFrame, source, self.config.block.arc)
	local result = "hit"

	if target.state == "Blocking" and front then
		if attack.breaksBlock then
			self.block:breakGuard(target, "breaker")
			result = "guardBreak"
		else
			local broke = self.block:absorb(target, damage)
			result = if broke then "guardBreak" else "blocked"
			self.api.Damaged:Fire(attacker, target, 0, result)
			if not broke then
				self.api.Broadcast(target.root.Position, "fx", "blocked", target.model)
			end
			return result
		end
	elseif target.state == "Blocking" then
		result = "backstab"
	end
	target.lastShieldHitAt = now

	target.humanoid:TakeDamage(damage)
	self.api.Broadcast(target.root.Position, "fx", "hit", target.model, result)
	if target.humanoid.Health > 0 then
		if result ~= "guardBreak" then
			self:stun(target, target:resolve(self.config.hit.hitStun), "hit")
		end
		local horizontal = if attack.knockback then attacker:resolve(attack.knockback) else 0
		local vertical = if attack.launch then attacker:resolve(attack.launch) else 0
		self:knockback(target, source, horizontal, vertical)
	end
	self.api.Damaged:Fire(attacker, target, damage, result)
	return result
end

return HitService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000013"><Properties><string name="Name">MovementAuthority</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))
local Ragdoll = require(script.Parent.Ragdoll)

local GROUND_MARGIN = 0.9
local AIR_MARGIN = 1.6
local VIOLATION_LOG_INTERVAL = 5
local AIR_JUMP_DEBOUNCE = 0.1

local MovementAuthority = {}
MovementAuthority.__index = MovementAuthority

local flat = CombatShared.flat

function MovementAuthority.new(api, config)
	local self = setmetatable({
		api = api,
		config = config,
		guards = setmetatable({}, { __mode = "k" }),
		params = setmetatable({}, { __mode = "k" }),
	}, MovementAuthority)

	api.RegisterAction("Run", function(c, on)
		if type(on) == "boolean" then
			c.running = on
		end
	end)

	api.RegisterAction("Dash", function(c)
		self:dash(c)
	end)
	api.RegisterAction("AirJump", function(c)
		self:airJump(c)
	end)
	api.RegisterAction("Climb", function(c, on)
		if on == true then
			self:startClimb(c)
		elseif on == false then
			self:stopClimb(c, "released")
		end
	end)
	api.RegisterAction("ClimbJump", function(c)
		self:stopClimb(c, "jump")
	end)
	return self
end

function MovementAuthority:_params(c)
	local p = self.params[c]
	if not p then
		p = RaycastParams.new()
		p.FilterType = Enum.RaycastFilterType.Exclude
		p.FilterDescendantsInstances = { c.model }
		p.IgnoreWater = false
		self.params[c] = p
	end
	return p
end

function MovementAuthority:_reply(c, ...)
	if c.player then
		self.api.Send(c.player, ...)
	end
end

function MovementAuthority:standHeight(c): number
	local hum = c.humanoid
	local legs = if hum.RigType == Enum.HumanoidRigType.R6 then 2 else hum.HipHeight
	return c.root.Size.Y / 2 + legs
end

function MovementAuthority:heightAboveGround(c, maxDistance: number?): number
	local origin = c.root.Position
	local result = Workspace:Raycast(origin, Vector3.new(0, -(maxDistance or 500), 0), self:_params(c))
	if not result then
		return math.huge
	end
	return origin.Y - result.Position.Y - self:standHeight(c)
end

function MovementAuthority:isGrounded(c): boolean
	return self:heightAboveGround(c, 30) <= GROUND_MARGIN
end

function MovementAuthority:_wallRay(c, direction: Vector3, extra: number)
	local reach = self.config.climb.reach + extra
	local params = self:_params(c)
	local origin = c.root.Position
	return Workspace:Raycast(origin, direction.Unit * reach, params) or Workspace:Raycast(origin + Vector3.new(0, 1.5, 0), direction.Unit * reach, params)
end

function MovementAuthority:_jumpRise(c): number
	local hum = c.humanoid
	local power = if hum.UseJumpPower then (c.baseJumpPower or hum.JumpPower) else nil
	if power then
		return power * power / (2 * Workspace.Gravity)
	end
	return c.baseJumpHeight or hum.JumpHeight
end

function MovementAuthority:_guard(c)
	local g = self.guards[c]
	if not g then
		local pos = c.root.Position
		g = {
			lastPos = pos,
			lastSafe = c.root.CFrame,
			debt = 0,
			ceiling = pos.Y + 50,
			allowances = {},
			graceUntil = self.api.now() + self.config.anticheat.spawnGrace,
			lastLog = -math.huge,
			violations = 0,
		}
		self.guards[c] = g
	end
	return g
end

function MovementAuthority:grant(c, horizontalSpeed: number, rise: number, duration: number)
	local g = self:_guard(c)
	local now = self.api.now()
	local entry = nil
	if horizontalSpeed > 0 then
		entry = { speed = horizontalSpeed, untilTime = now + duration }
		table.insert(g.allowances, entry)
	end
	if rise > 0 then
		local ac = self.config.anticheat
		g.ceiling = math.max(g.ceiling, c.root.Position.Y + rise * ac.verticalTolerance + ac.verticalSlack)
	end
	return entry
end

function MovementAuthority:resetGuard(c, grace: number?)
	local g = self:_guard(c)
	g.lastPos = c.root.Position
	g.lastSafe = c.root.CFrame
	g.debt = 0
	g.ceiling = c.root.Position.Y + 50
	g.graceUntil = math.max(g.graceUntil, self.api.now() + (grace or self.config.anticheat.spawnGrace))
end

function MovementAuthority:_violate(c, g, kind: string, detail: string)
	g.violations += 1
	local now = self.api.now()
	if now - g.lastLog >= VIOLATION_LOG_INTERVAL then
		g.lastLog = now
		warn(("[CombatSystem] movement rejected for %s (%s: %s); total %d"):format(c.model.Name, kind, detail, g.violations))
	end
	if c.state == "Climbing" then
		self:stopClimb(c, "correction")
	elseif c.state == "Dashing" then
		c:setState("Idle")
	end
	c.root.CFrame = g.lastSafe
	c.root.AssemblyLinearVelocity = Vector3.zero
	g.lastPos = g.lastSafe.Position
	g.debt = 0
	g.ceiling = g.lastSafe.Position.Y + self:_jumpRise(c) * self.config.anticheat.verticalTolerance + self.config.anticheat.verticalSlack
	table.clear(g.allowances)
	c.changed:Fire("violation", kind)
	self:_reply(c, "correction", kind)
end

function MovementAuthority:_pendingAirRise(c): number
	local state = c.state
	local fallRagdoll = state == "Ragdoll" and c.ragdollReason == "fall"
	if state ~= "Idle" and state ~= "Dashing" and not fallRagdoll then
		return 0
	end
	if c.airJumps >= self:_maxAirJumps(c, not c.isNPC) then
		return 0
	end
	local cfg = self.config.jump
	local power = if c.airJumps >= 1 then c:resolve(cfg.skyJump.power) else c:resolve(cfg.doubleJumpPower)
	local rising = math.max(0, c.root.AssemblyLinearVelocity.Y)
	return power * power / (2 * Workspace.Gravity) * self.config.anticheat.verticalTolerance + rising * 0.25
end

function MovementAuthority:_checkMovement(c, now: number, dt: number, grounded: boolean)
	local ac = self.config.anticheat
	local g = self:_guard(c)
	local pos = c.root.Position
	if c.humanoid.SeatPart or now < g.graceUntil then
		g.lastPos = pos
		g.lastSafe = c.root.CFrame
		g.ceiling = math.max(g.ceiling, pos.Y + self:_jumpRise(c) * ac.verticalTolerance + ac.verticalSlack)
		return
	end

	local delta = pos - g.lastPos
	if delta.Magnitude > ac.teleportDistance then
		self:_violate(c, g, "teleport", ("%.1f studs in one step"):format(delta.Magnitude))
		return
	end

	local allowed = math.max(c.humanoid.WalkSpeed, c:resolve(self.config.run.walkSpeed))
	for i = #g.allowances, 1, -1 do
		local a = g.allowances[i]
		if now > a.untilTime then
			table.remove(g.allowances, i)
		elseif a.speed > allowed then
			allowed = a.speed
		end
	end
	if c.state == "Climbing" then
		allowed = math.max(allowed, c:resolve(self.config.climb.speed))
	end
	g.debt = math.max(0, g.debt + flat(delta).Magnitude - allowed * ac.speedTolerance * dt)
	if g.debt > ac.horizontalSlack and self:_implicitDash(c) then
		g.debt = math.max(0, g.debt - c:resolve(self.config.dash.distance))
	end
	if g.debt > ac.horizontalSlack then
		self:_violate(c, g, "speed", ("%.1f studs over the allowed path"):format(g.debt))
		return
	end

	if grounded then
		g.ceiling = pos.Y + self:_jumpRise(c) * ac.verticalTolerance + ac.verticalSlack
	elseif c.state == "Climbing" then
		g.ceiling = math.max(g.ceiling, pos.Y + c:resolve(self.config.climb.speed) * 0.5 + ac.verticalSlack)
	end
	local top = g.ceiling
	if not grounded and c.state ~= "Climbing" then
		top += self:_pendingAirRise(c)
	end
	if pos.Y > top then
		self:_violate(c, g, "height", ("%.1f studs above the allowed height"):format(pos.Y - top))
		return
	end

	g.lastPos = pos
	if grounded and g.debt < ac.horizontalSlack * 0.5 then
		g.lastSafe = c.root.CFrame
	end
end

function MovementAuthority:speedFor(c): number
	local cfg = self.config
	local state = c.state
	if state == "Stunned" or state == "Ragdoll" then
		return 0
	end
	if state == "Blocking" then
		return c:resolve(cfg.block.walkSpeed)
	end
	if state == "Attacking" and cfg.run.cancelOnAction then
		return c:resolve(cfg.run.walkSpeed)
	end
	if c.running then
		return c:resolve(cfg.run.speed)
	end
	return c:resolve(cfg.run.walkSpeed)
end

function MovementAuthority:_applyJumpLock(c)
	local hum = c.humanoid
	if c.baseJumpPower == nil then
		c.baseJumpPower = hum.JumpPower
		c.baseJumpHeight = hum.JumpHeight
	end
	local state = c.state
	local locked = state == "Stunned" or state == "Ragdoll" or state == "Climbing" or state == "Attacking" or state == "Blocking"
	local power = if locked then 0 else c.baseJumpPower
	local height = if locked then 0 else c.baseJumpHeight
	if hum.JumpPower ~= power then
		hum.JumpPower = power
	end
	if hum.JumpHeight ~= height then
		hum.JumpHeight = height
	end
end

function MovementAuthority:_implicitDash(c): boolean
	if not c:canAct() or c.state ~= "Idle" or not c:isReady("Dash") then
		return false
	end
	if self:_beginDash(c) then
		c.implicitDashAt = self.api.now()
		return true
	end
	return false
end

function MovementAuthority:_beginDash(c): boolean
	local cfg = self.config.dash
	local distance = c:resolve(cfg.distance)
	local duration = c:resolve(cfg.duration)
	c:setState("Dashing", duration)
	c:startCooldown("Dash", c:resolve(cfg.cooldown))
	if cfg.iFrames then
		c.invulnerableUntil = self.api.now() + duration
	end
	self:grant(c, distance / duration, 0, duration + 0.4)
	return true
end

function MovementAuthority:dash(c)
	local cfg = self.config.dash
	if c.implicitDashAt and self.api.now() - c.implicitDashAt < 0.6 then
		c.implicitDashAt = nil
		self:_reply(c, "dash", true, c:resolve(cfg.duration), c:resolve(cfg.distance))
		return true
	end
	if not c:canAct() or c.state ~= "Idle" or not c:isReady("Dash") then
		self:_reply(c, "dash", false)
		return false
	end
	self:_beginDash(c)
	self:_reply(c, "dash", true, c:resolve(cfg.duration), c:resolve(cfg.distance))
	return true
end

function MovementAuthority:_maxAirJumps(c, canSky: boolean): number
	if canSky and c:hasUnlock("skyJump") then
		return math.huge
	end
	return 1
end

function MovementAuthority:airJump(c, direction: Vector3?)
	local cfg = self.config.jump
	local now = self.api.now()
	local fallRagdoll = c.state == "Ragdoll" and c.ragdollReason == "fall"
	local deny = not c:isAlive() or (c.state ~= "Idle" and c.state ~= "Dashing" and not fallRagdoll)
	if not deny and self:heightAboveGround(c, 30) <= AIR_MARGIN then
		deny = true
	end
	if not deny and now - (c.lastAirJumpAt or -math.huge) < AIR_JUMP_DEBOUNCE then
		deny = true
	end
	if not deny and c.airJumps >= 1 and not c:isReady("SkyJump") then
		deny = true
	end
	if not deny and c.airJumps >= self:_maxAirJumps(c, not c.isNPC) then
		deny = true
	end
	if deny then
		self:_reply(c, "airJump", false, c.airJumps)
		return false
	end

	c.airJumps += 1
	c.lastAirJumpAt = now
	local isSky = c.airJumps >= 2
	local power = if isSky then c:resolve(cfg.skyJump.power) else c:resolve(cfg.doubleJumpPower)
	local horizontal = if isSky then c:resolve(cfg.skyJump.horizontalSpeed) else 0
	if isSky then
		c:startCooldown("SkyJump", c:resolve(cfg.skyJump.cooldown))
	end
	if fallRagdoll then
		self:endRagdoll(c)
	end
	local airTime = 2 * power / Workspace.Gravity + 0.5
	self:grant(c, horizontal + c.humanoid.WalkSpeed, power * power / (2 * Workspace.Gravity), airTime)
	if c.isNPC then
		local dir = if direction and flat(direction).Magnitude > 1e-3 then flat(direction).Unit else Vector3.zero
		local v = c.root.AssemblyLinearVelocity
		local h = if isSky then dir * horizontal else Vector3.new(v.X, 0, v.Z)
		c.root.AssemblyLinearVelocity = Vector3.new(h.X, power, h.Z)
	end
	self:_reply(c, "airJump", true, c.airJumps, isSky)
	self.api.Broadcast(c.root.Position, "fx", if isSky then "skyJump" else "doubleJump", c.model)
	return true
end

function MovementAuthority:startClimb(c)
	if not c:canAct() or c.state ~= "Idle" or not c:isReady("Climb") then
		self:_reply(c, "climb", false, "denied")
		return false
	end
	local look = flat(c.root.CFrame.LookVector)
	local hit = look.Magnitude > 1e-3 and self:_wallRay(c, look, 1.5)
	if not hit or math.abs(hit.Normal.Y) > 0.5 then
		self:_reply(c, "climb", false, "no wall")
		return false
	end
	local now = self.api.now()
	local duration = c:resolve(self.config.climb.time)
	c.climb = { normal = hit.Normal, startedAt = now, endsAt = now + duration, nextCheck = now, misses = 0 }
	c.airJumps = 0
	c:setState("Climbing")
	self:_reply(c, "climb", true, c.climb.endsAt, duration, hit.Normal)
	return true
end

function MovementAuthority:stopClimb(c, reason: string)
	if c.state ~= "Climbing" then
		return
	end
	local cfg = self.config.climb
	c.climb = nil
	c:setState("Idle")
	c:startCooldown("Climb", cfg.cooldown)
	c.airJumps = 0
	if reason == "jump" then
		local power = c:resolve(cfg.jumpPower)
		self:grant(c, c:resolve(cfg.jumpAwaySpeed) + c.humanoid.WalkSpeed, power * power / (2 * Workspace.Gravity), 2 * power / Workspace.Gravity + 0.5)
	else
		self:grant(c, c:resolve(cfg.speed), 4, 0.6)
	end
	self:_reply(c, "climb", false, reason)
	if reason == "stamina" or reason == "wall" then
		if self:heightAboveGround(c) > cfg.ragdollFallHeight then
			self:startRagdoll(c, "fall")
		end
	end
end

function MovementAuthority:startRagdoll(c, reason: string)
	if not c:isAlive() then
		return
	end
	c.ragdollReason = reason
	c.ragdollSince = self.api.now()
	c:setState("Ragdoll")
	c.ragdollAllowance = self:grant(c, 25, 0, self.config.ragdoll.maxTime)
	Ragdoll.enable(c.model, c.humanoid, c.isNPC)
	self:_reply(c, "ragdoll", true, reason)
end

function MovementAuthority:endRagdoll(c)
	if c.state ~= "Ragdoll" then
		return
	end
	Ragdoll.disable(c.model, c.humanoid, c.isNPC)
	if c.ragdollAllowance then
		c.ragdollAllowance.untilTime = 0
		c.ragdollAllowance = nil
	end
	c.ragdollReason = nil
	c.ragdollSince = nil
	c:setState("Idle")
	self:_reply(c, "ragdoll", false)
end

function MovementAuthority:_updateClimb(c, now: number)
	local climb = c.climb
	if not climb then
		c:setState("Idle")
		return
	end
	if now >= climb.endsAt then
		self:stopClimb(c, "stamina")
		return
	end
	if now < climb.nextCheck then
		return
	end
	climb.nextCheck = now + self.config.climb.wallCheckInterval
	local hit = self:_wallRay(c, -climb.normal, 2)
	if hit and math.abs(hit.Normal.Y) <= 0.5 then
		climb.normal = hit.Normal
		climb.misses = 0
	else
		climb.misses += 1
		if climb.misses >= self.config.climb.wallMisses then
			self:stopClimb(c, "wall")
		end
	end
end

function MovementAuthority:update(c, now: number, dt: number)
	if not c:isAlive() then
		return
	end
	local grounded = self:isGrounded(c)
	if grounded and c.state ~= "Climbing" then
		c.airJumps = 0
	end
	if c.state == "Climbing" then
		self:_updateClimb(c, now)
	elseif c.state == "Ragdoll" then
		local since = c.ragdollSince or now
		local cfg = self.config.ragdoll
		if (grounded and now - since >= cfg.minTime and c.root.AssemblyLinearVelocity.Magnitude < 6) or now - since >= cfg.maxTime then
			self:endRagdoll(c)
		end
	end
	self:_applyJumpLock(c)
	if c.player then
		if grounded or c.state == "Stunned" or c.state == "Ragdoll" then
			local target = self:speedFor(c)
			if c.humanoid.WalkSpeed ~= target then
				c.humanoid.WalkSpeed = target
			end
		end
		if self.config.anticheat.enabled then
			self:_checkMovement(c, now, dt, grounded)
		end
	end
end

function MovementAuthority:forget(c)
	if c.state == "Ragdoll" and c.model.Parent then
		Ragdoll.disable(c.model, c.humanoid, c.isNPC)
	end
	self.guards[c] = nil
	self.params[c] = nil
end

return MovementAuthority
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000014"><Properties><string name="Name">NPCService</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))

local PROFILE_ATTRIBUTE = "CombatProfile"
local DEFAULT_INTERVAL = { 0.2, 0.4 }

local flat = CombatShared.flat

local LOCKED_STATES = {
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.Ragdoll,
	Enum.HumanoidStateType.GettingUp,
	Enum.HumanoidStateType.PlatformStanding,
}
local UPRIGHT_LIMIT = 0.995

local NPCService = {}
NPCService.__index = NPCService

function NPCService.new(system, config, profiles)
	return setmetatable({
		system = system,
		config = config,
		profiles = profiles,
		rng = Random.new(),
		entries = {},
		connections = {},
		warned = {},
		running = false,
	}, NPCService)
end

function NPCService:_track(model: Instance)
	if not self.running or not model:IsA("Model") or self.entries[model] or not model:IsDescendantOf(Workspace) then
		return
	end
	local tag = model:GetAttribute(PROFILE_ATTRIBUTE)
	if type(tag) ~= "string" then
		return
	end
	local profile = self.profiles[tag]
	if not profile then
		if not self.warned[tag] then
			self.warned[tag] = true
			warn(("[CombatSystem] %s has %s = '%s', which is not a valid NPC profile in config.npcs."):format(model:GetFullName(), PROFILE_ATTRIBUTE, tag))
		end
		return
	end
	local archivable = model.Archivable
	model.Archivable = true
	local template = model:Clone()
	model.Archivable = archivable
	local c = self.system.RegisterNPC(model, tag)
	if not c then
		return
	end
	local humanoid = c.humanoid
	humanoid.AutoRotate = false
	local tool = model:FindFirstChildOfClass("Tool")
	if tool then
		task.defer(function()
			if tool.Parent == model and humanoid.Parent == model then
				humanoid:EquipTool(tool)
			end
		end)
	end
	for _, state in ipairs(LOCKED_STATES) do
		humanoid:SetStateEnabled(state, false)
	end
	local entry = {
		model = model,
		combatant = c,
		profile = profile,
		template = template,
		parent = model.Parent,
		nextActionAt = 0,
		sequenceIndex = 0,
	}
	self.entries[model] = entry
	c.humanoid.Died:Connect(function()
		self:_onDied(entry)
	end)
end

function NPCService:_onDied(entry)
	self.entries[entry.model] = nil
	local delay = entry.profile.respawnTime
	if not delay or delay <= 0 or not entry.template then
		return
	end
	task.delay(delay, function()
		if not self.running then
			return
		end
		if entry.model.Parent then
			entry.model:Destroy()
		end
		if entry.parent and entry.parent:IsDescendantOf(Workspace) then
			entry.template:Clone().Parent = entry.parent
		end
	end)
end

function NPCService:start()
	self.running = true
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:IsA("Model") then
			self:_track(inst)
		end
	end
	table.insert(self.connections, Workspace.DescendantAdded:Connect(function(inst)
		if inst:IsA("Model") then
			task.defer(function()
				self:_track(inst)
			end)
		end
	end))
end

function NPCService:stop()
	self.running = false
	for _, c in ipairs(self.connections) do
		c:Disconnect()
	end
	table.clear(self.connections)
	table.clear(self.entries)
end

function NPCService:_interval(profile): number
	local range = profile.interval or DEFAULT_INTERVAL
	return self.rng:NextNumber(range[1], range[2])
end

function NPCService:_nearestPlayer(c, range: number)
	local best, bestDistance = nil, range
	for _, other in ipairs(self.system.GetCombatants()) do
		if not other.isNPC and other:isAlive() then
			local d = (other.root.Position - c.root.Position).Magnitude
			if d <= bestDistance then
				best, bestDistance = other, d
			end
		end
	end
	return best
end

function NPCService:_isReady(c, id: string): boolean
	if id == "M1" then
		return c:isReady("M1")
	end
	return c:isReady(c.weapon .. "." .. id)
end

function NPCService:_pick(entry): string?
	local profile = entry.profile
	local c = entry.combatant
	if profile.abilityMode == "sequence" then
		local id = profile.sequence[entry.sequenceIndex % #profile.sequence + 1]
		return if self:_isReady(c, id) then id else nil
	end
	local weapon = self.system.GetWeapon(c.weapon)
	if not weapon then
		return nil
	end
	local options = { "M1" }
	for _, ability in ipairs(weapon.abilities) do
		table.insert(options, ability.id)
	end
	local total, pool = 0, {}
	for _, id in ipairs(options) do
		local weight = if profile.weights then profile.weights[id] or 0 else 1
		if weight > 0 and self:_isReady(c, id) then
			total += weight
			table.insert(pool, { id = id, weight = weight })
		end
	end
	if total <= 0 then
		return nil
	end
	local roll = self.rng:NextNumber(0, total)
	for _, option in ipairs(pool) do
		roll -= option.weight
		if roll <= 0 then
			return option.id
		end
	end
	return pool[#pool].id
end

function NPCService:_turn(c, direction: Vector3)
	local position = c.root.Position
	c.root.CFrame = CFrame.lookAt(position, position + direction)
	c.root.AssemblyAngularVelocity = Vector3.zero
end

function NPCService:_stabilize(c)
	local root = c.root
	if c.state == "Ragdoll" then
		return
	end
	if root.CFrame.UpVector.Y >= UPRIGHT_LIMIT and root.AssemblyAngularVelocity.Magnitude < 0.5 then
		return
	end
	local look = flat(root.CFrame.LookVector)
	if look.Magnitude < 1e-3 then
		look = flat(root.CFrame.UpVector)
	end
	if look.Magnitude < 1e-3 then
		look = Vector3.new(0, 0, -1)
	end
	self:_turn(c, look.Unit)
end

function NPCService:_face(c, target)
	local delta = target.root.Position - c.root.Position
	local to = flat(delta)
	if to.Magnitude < 1e-3 then
		return
	end
	c.aimDirection = delta.Unit
	self:_turn(c, to.Unit)
end

function NPCService:_act(entry, now: number)
	local c = entry.combatant
	local profile = entry.profile
	local services = self.system.GetServices()
	if profile.behavior == "block" then
		if c.state == "Idle" and services.block then
			services.block:raise(c)
		end
	elseif profile.behavior == "attack" and services.attack then
		local target = self:_nearestPlayer(c, profile.range)
		if target then
			self:_face(c, target)
		else
			c.aimDirection = nil
		end
		if c.state == "Idle" and (target or profile.attackWithoutTarget) then
			local id = self:_pick(entry)
			if id then
				local ok = if id == "M1" then services.attack:m1(c) else services.attack:ability(c, id)
				if ok then
					entry.sequenceIndex += 1
				end
			end
		end
	end
	entry.nextActionAt = now + self:_interval(profile)
end

function NPCService:update(now: number)
	for model, entry in pairs(self.entries) do
		local c = entry.combatant
		if c.destroyed then
			self.entries[model] = nil
		elseif c:isAlive() then
			self:_stabilize(c)
			if entry.profile.behavior ~= "idle" and now >= entry.nextActionAt then
				self:_act(entry, now)
			end
		end
	end
end

return NPCService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000015"><Properties><string name="Name">Ragdoll</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))

local ROOT_JOINTS = { RootJoint = true, Root = true }

local Ragdoll = {}

local rigs = setmetatable({}, { __mode = "k" })

local function newSocket(parent: Instance, a0: Attachment, a1: Attachment)
	local socket = CombatShared.template("Physics", "RagdollSocket")
	if not socket then
		return nil
	end
	socket.Attachment0 = a0
	socket.Attachment1 = a1
	socket.Enabled = false
	socket.Parent = parent
	return socket
end

local function newAttachment(parent: Instance, cframe: CFrame)
	local attachment = CombatShared.template("Physics", "RagdollAttachment")
	if attachment then
		attachment.CFrame = cframe
		attachment.Parent = parent
	end
	return attachment
end

local function build(model: Model)
	local rig = { joints = {}, parts = {} }
	for _, joint in ipairs(model:GetDescendants()) do
		if joint:IsA("AnimationConstraint") and not ROOT_JOINTS[joint.Name] and joint.Attachment0 and joint.Attachment1 then
			local part = joint.Attachment1.Parent
			local socket = joint.Parent and joint.Parent:FindFirstChild(joint.Name .. "BallSocket")
			if not (socket and socket:IsA("BallSocketConstraint")) then
				socket = newSocket(joint.Parent, joint.Attachment0, joint.Attachment1)
			end
			if socket and part and part:IsA("BasePart") then
				table.insert(rig.joints, { motor = joint, socket = socket, part = part, socketWasEnabled = socket.Enabled })
			end
		end
	end
	for _, motor in ipairs(model:GetDescendants()) do
		if motor:IsA("Motor6D") and not ROOT_JOINTS[motor.Name] and motor.Part0 and motor.Part1 then
			local a0 = newAttachment(motor.Part0, motor.C0)
			local a1 = newAttachment(motor.Part1, motor.C1)
			local socket = a0 and a1 and newSocket(motor.Part1, a0, a1)
			if socket then
				table.insert(rig.joints, { motor = motor, socket = socket, part = motor.Part1, socketWasEnabled = false })
			end
		end
	end
	rigs[model] = rig
	return rig
end

function Ragdoll.isActive(model: Model): boolean
	local rig = rigs[model]
	return rig ~= nil and rig.active == true
end

function Ragdoll.enable(model: Model, humanoid: Humanoid, serverOwned: boolean)
	local rig = rigs[model] or build(model)
	if rig.active then
		return
	end
	rig.active = true
	rig.requiresNeck = humanoid.RequiresNeck
	humanoid.RequiresNeck = false
	for _, joint in ipairs(rig.joints) do
		if joint.motor.Parent then
			joint.socket.Enabled = true
			joint.motor.Enabled = false
			rig.parts[joint.part] = joint.part.CanCollide
			joint.part.CanCollide = true
		end
	end
	if serverOwned then
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end
end

function Ragdoll.disable(model: Model, humanoid: Humanoid, serverOwned: boolean)
	local rig = rigs[model]
	if not rig or not rig.active then
		return
	end
	rig.active = false
	for _, joint in ipairs(rig.joints) do
		if joint.motor.Parent then
			joint.motor.Enabled = true
			joint.socket.Enabled = joint.socketWasEnabled == true
		end
		local canCollide = rig.parts[joint.part]
		if canCollide ~= nil and joint.part.Parent then
			joint.part.CanCollide = canCollide
		end
	end
	table.clear(rig.parts)
	if rig.requiresNeck ~= nil then
		humanoid.RequiresNeck = rig.requiresNeck
	end
	if serverOwned and humanoid.Health > 0 then
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

return Ragdoll
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000016"><Properties><string name="Name">StatsService</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CombatShared = require(ReplicatedStorage:WaitForChild("CombatShared"))

local DATA_VERSION = 1
local SAVE_ATTEMPTS = 3

local StatsService = {}
StatsService.__index = StatsService

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

function StatsService.new(config)
	return setmetatable({
		cfg = config.stats,
		profiles = {},
		changed = CombatShared.newSignal(),
		connections = {},
		store = nil,
		running = false,
	}, StatsService)
end

function StatsService:_blank()
	return {
		version = DATA_VERSION,
		stats = table.clone(self.cfg.defaults),
		unlocks = table.clone(self.cfg.unlocks),
	}
end

function StatsService:_merge(raw)
	local data = self:_blank()
	if type(raw) ~= "table" then
		return data
	end
	if type(raw.stats) == "table" then
		for key in pairs(data.stats) do
			local v = raw.stats[key]
			if CombatShared.isFinite(v) then
				data.stats[key] = v
			end
		end
	end
	if type(raw.unlocks) == "table" then
		for key in pairs(data.unlocks) do
			if type(raw.unlocks[key]) == "boolean" then
				data.unlocks[key] = raw.unlocks[key]
			end
		end
	end
	return data
end

function StatsService:_publishAll(player: Player, profile)
	for key, value in pairs(profile.data.stats) do
		player:SetAttribute("Stat_" .. key, value)
	end
	for key, value in pairs(profile.data.unlocks) do
		player:SetAttribute("Unlock_" .. key, value)
	end
	profile.view = table.freeze(table.clone(profile.data.stats))
end

function StatsService:_load(player: Player)
	local profile = { data = self:_blank(), loaded = false, canSave = false, saving = false }
	profile.view = table.freeze(table.clone(profile.data.stats))
	self.profiles[player] = profile

	local store = self.store
	if store then
		local key = keyFor(player)
		local attempts = self.cfg.loadAttempts
		for attempt = 1, attempts do
			local locked = false
			local ok, result = pcall(function()
				return store:UpdateAsync(key, function(old)
					old = old or {}
					local lock = old.lock
					if type(lock) == "table" and lock.jobId ~= game.JobId and os.time() - (lock.time or 0) < self.cfg.sessionLockTimeout and attempt < attempts then
						locked = true
						return nil
					end
					old.lock = { jobId = game.JobId, time = os.time() }
					return old
				end)
			end)
			if self.profiles[player] ~= profile then
				if ok and not locked then
					self:_save(player, { data = self:_merge(result), loaded = true, canSave = true, saving = false }, true)
				end
				return
			end
			if ok and not locked then
				profile.data = self:_merge(result)
				profile.loaded = true
				profile.canSave = true
				break
			end
			if not ok then
				local message = tostring(result)
				if RunService:IsStudio() and (message:find("403", 1, true) or message:find("StudioAccessToApisNotAllowed", 1, true)) then
					warn("[CombatSystem] Studio has no DataStore access (Game Settings > Security > Enable Studio Access to API Services); stats are session-only.")
					break
				end
				warn(("[CombatSystem] stats load failed for %s (attempt %d/%d): %s"):format(player.Name, attempt, attempts, message))
			end
			task.wait(self.cfg.retryDelay)
		end
		if not profile.loaded then
			warn(("[CombatSystem] could not load stats for %s; using defaults for this session without saving."):format(player.Name))
		end
	end

	if self.profiles[player] ~= profile then
		return
	end
	self:_publishAll(player, profile)
	player:SetAttribute("CombatStatsLoaded", true)
	self.changed:Fire(player, "loaded")
	if not player.Parent then
		self:_release(player)
	end
end

function StatsService:_save(player: Player, profile, release: boolean): boolean
	if not self.store or not profile.canSave then
		return true
	end
	while profile.saving do
		task.wait(0.1)
	end
	profile.saving = true
	local snapshot = {
		version = DATA_VERSION,
		stats = table.clone(profile.data.stats),
		unlocks = table.clone(profile.data.unlocks),
		lock = if release then nil else { jobId = game.JobId, time = os.time() },
	}
	local key = keyFor(player)
	local saved = false
	for attempt = 1, SAVE_ATTEMPTS do
		local stolen = false
		local ok, err = pcall(function()
			self.store:UpdateAsync(key, function(old)
				if type(old) == "table" and type(old.lock) == "table" and old.lock.jobId ~= game.JobId then
					stolen = true
					return nil
				end
				return snapshot
			end)
		end)
		if ok then
			saved = not stolen
			if stolen then
				warn(("[CombatSystem] stats of %s are locked by another server; not saved."):format(player.Name))
				profile.canSave = false
			end
			break
		end
		warn(("[CombatSystem] stats save failed for %s (attempt %d/%d): %s"):format(player.Name, attempt, SAVE_ATTEMPTS, tostring(err)))
		if attempt < SAVE_ATTEMPTS then
			task.wait(self.cfg.retryDelay)
		end
	end
	profile.saving = false
	if release then
		profile.canSave = false
	end
	return saved
end

function StatsService:_release(player: Player)
	local profile = self.profiles[player]
	if not profile then
		return
	end
	self.profiles[player] = nil
	if profile.loaded then
		self:_save(player, profile, true)
	end
end

function StatsService:start()
	if self.running then
		return
	end
	self.running = true
	local studio = RunService:IsStudio()
	if studio and not self.cfg.saveInStudio then
		warn("[CombatSystem] stats.saveInStudio is false; stats are session-only in Studio.")
	else
		local name = if studio then self.cfg.studioDataStoreName else self.cfg.dataStoreName
		local ok, result = pcall(DataStoreService.GetDataStore, DataStoreService, name)
		if ok then
			self.store = result
		else
			warn(("[CombatSystem] DataStore unavailable (%s); stats are session-only. In Studio, enable 'Studio Access to API Services'."):format(tostring(result)))
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(self._load, self, player)
	end
	table.insert(self.connections, Players.PlayerAdded:Connect(function(player)
		self:_load(player)
	end))
	table.insert(self.connections, Players.PlayerRemoving:Connect(function(player)
		self:_release(player)
	end))

	task.spawn(function()
		while self.running do
			task.wait(self.cfg.autosaveInterval)
			if not self.running then
				break
			end
			for player, profile in pairs(self.profiles) do
				if profile.loaded and profile.dirty then
					profile.dirty = false
					task.spawn(self._save, self, player, profile, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		if not self.running then
			return
		end
		local pending = 0
		for player in pairs(table.clone(self.profiles)) do
			pending += 1
			task.spawn(function()
				self:_release(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

function StatsService:stop()
	if not self.running then
		return
	end
	self.running = false
	for _, c in ipairs(self.connections) do
		c:Disconnect()
	end
	table.clear(self.connections)
	for player in pairs(table.clone(self.profiles)) do
		task.spawn(self._release, self, player)
	end
end

function StatsService:isLoaded(player: Player): boolean
	local profile = self.profiles[player]
	return profile ~= nil and profile.loaded
end

function StatsService:get(player: Player)
	local profile = self.profiles[player]
	if profile then
		return profile.view
	end
	return table.freeze(table.clone(self.cfg.defaults))
end

function StatsService:set(player: Player, key: string, value: number): boolean
	local profile = self.profiles[player]
	if not profile or profile.data.stats[key] == nil or not CombatShared.isFinite(value) then
		return false
	end
	profile.data.stats[key] = value
	profile.dirty = true
	profile.view = table.freeze(table.clone(profile.data.stats))
	player:SetAttribute("Stat_" .. key, value)
	self.changed:Fire(player, "stat", key, value)
	return true
end

function StatsService:add(player: Player, key: string, delta: number): boolean
	local profile = self.profiles[player]
	if not profile or profile.data.stats[key] == nil or not CombatShared.isFinite(delta) then
		return false
	end
	return self:set(player, key, profile.data.stats[key] + delta)
end

function StatsService:getUnlock(player: Player, key: string): boolean
	local profile = self.profiles[player]
	return profile ~= nil and profile.data.unlocks[key] == true
end

function StatsService:setUnlock(player: Player, key: string, value: boolean): boolean
	local profile = self.profiles[player]
	if not profile or profile.data.unlocks[key] == nil or type(value) ~= "boolean" then
		return false
	end
	profile.data.unlocks[key] = value
	profile.dirty = true
	player:SetAttribute("Unlock_" .. key, value)
	self.changed:Fire(player, "unlock", key, value)
	return true
end

return StatsService
