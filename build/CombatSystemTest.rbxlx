			recovery = 0.33,
			hitbox = { size = Vector3.new(5, 5, 5), offset = CFrame.new(0, 0, -3) },
			damage = function(s)
				return 14 + s.strength * 0.25
			end,
			knockback = 50,
			breaksBlock = true,
			animation = HEAVY,
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXCS000005"><Properties><string name="Name">Sword</string><ProtectedString name="Source"><![CDATA[--!nonstrict

local HITBOX = { size = Vector3.new(6, 5, 6), offset = CFrame.new(0, 0, -3.5) }

local STANCE = { leftLeg = { 20, 0, 0 }, rightLeg = { -14, 0, 0 } }

local function withStance(pose)
	for joint, angles in pairs(STANCE) do
		pose[joint] = angles
	end
	return pose
end

local OVERHEAD = {
	duration = 0.46,
	keyframes = {
		{ t = 0, pose = {} },
		{ t = 0.09, pose = withStance({ rightArm = { 165, 0, -12 }, leftArm = { 35, 0, -25 }, torso = { 12, -22, 0 } }) },
